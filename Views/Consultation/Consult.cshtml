@model Models.Consultation

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Patient Consultation";
}

@section Styles{
    <link rel="stylesheet" href="~/css/consultation.css" asp-append-version="true" />
}

<form asp-action="Consult" method="post"
      class="consultation-form">

    <input asp-for="ConsultationId" type="hidden" />
    <input asp-for="AppointmentId" type="hidden" />
    <input asp-for="TemplateId" type="hidden" />
    <input asp-for="TemplateName" type="hidden" />
    <input asp-for="PatientId" type="hidden" />

    <!-- ====================================================== -->
    <!-- Patient Header -->
    <!-- ====================================================== -->

    <div class="card consultation-card patient-summary">

        <div class="card-body">

            <div class="row">

                <div class="col-md-3">
                    <div class="patient-item">
                        <span class="patient-label">Patient ID</span>
                        <span>@Model.PatientId</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="patient-item">
                        <span class="patient-label">Name</span>
                        <span class="patient-value">@Model.PatientName</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="patient-item">
                        <span class="patient-label">Gender</span>
                        <span class="patient-value">@Model.Gender</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="patient-item">
                        <span class="patient-label">Age</span>
                        <span class="patient-value">@Model.Age</span>
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-3">
                    <div class="patient-item">
                        <span class="patient-label">Doctor</span>
                        <span class="patient-value">@Model.DoctorName</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="patient-item">
                        <span class="patient-label">Appointment Date</span>
                        <span class="patient-value">@Model.AppointmentDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="patient-item">
                        <span class="patient-label">Time</span>
                        <span class="patient-value">@Model.SlotStartTime.ToString(@"hh\:mm")</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="patient-item">
                        <span class="patient-label">Status</span>
                        <span class="patient-value">@Model.Status</span>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- ====================================================== -->
    <!-- Dynamic Sections -->
    <!-- ====================================================== -->

    @Html.EditorFor(m => m.Sections)

    <div class="consultation-actions">

        <button class="btn btn-secondary"
                type="submit"
                name="Status"
                value="Draft"
                asp-action="Save">

            Save Draft

        </button>

        <button class="btn btn-success"
                type="submit"
                name="Status"
                value="Completed">

            Complete Consultation

        </button>

    </div>

</form>

@section Scripts
{
    <script src="~/js/consultation.js" asp-append-version="true"></script>
}