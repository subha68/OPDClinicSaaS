@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Consultation";
}

@model List<Models.Appointment>

@if (TempData["Success"] != null)
{
    @TempData["Success"]
}

<div class="table-responsive">
    <table class="table appointments-table">
        <thead>
            <tr>
                <th>Time</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Status</th>
                <th class="action-column">Action</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.SlotTime.ToString(@"hh\:mm")
                        </td>

                        <td>
                            @item.PatientName
                        </td>

                        <td>
                            @item.DoctorName
                        </td>

                        <td>
                            @if (item.Status == "Booked")
                            {
                                <span class="badge bg-primary">
                                    @item.Status
                                </span>
                            }
                            else if (item.Status == "In Consultation")
                            {
                                <span class="badge bg-warning text-dark">
                                    @item.Status
                                </span>
                            }
                            else if (item.Status == "Completed")
                            {
                                <span class="badge bg-success">
                                    @item.Status
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @item.Status
                                </span>
                            }
                        </td>

                        <!-- ACTION -->
                        <td class="action-column">

                            @if (item.Status == "Booked")
                            {
                                <a asp-controller="Consultation"
                                asp-action="Start"
                                asp-route-appointmentId="@item.AppointmentId"
                                class="btn btn-success btn-sm">
                                    Start Consultation
                                </a>
                            }
                            else if (item.Status == "In Consultation")
                            {
                                <a asp-controller="Consultation"
                                asp-action="Consult"
                                asp-route-appointmentId="@item.AppointmentId"
                                class="btn btn-warning btn-sm">
                                    Resume
                                </a>

                                <a asp-controller="Consultation"
                                asp-action="Preview"
                                asp-route-appointmentId="@item.AppointmentId"
                                class="btn btn-success btn-sm ms-1">
                                    <i class="fa fa-file-prescription"></i>
                                    Prescription
                                </a>
                            }
                            else if (item.Status == "Completed")
                            {
                                <a asp-controller="Consultation"
                                asp-action="Preview"
                                asp-route-appointmentId="@item.AppointmentId"
                                class="btn btn-success btn-sm">
                                    <i class="fa fa-file-prescription"></i>
                                    Prescription
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5"
                        class="text-center text-muted">
                        No appointments for today
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
