@model Models.ConsultationRow

@using System

<tr data-rowid="@Model.RowId"
    data-rownumber="@Model.RowNumber"
    data-rowguid="@Model.RowGuid">

    <input asp-for="RowGuid" type="hidden" class="row-guid" />
    <input asp-for="RowNumber" type="hidden" class="row-number-hidden" />
    <input asp-for="RowId" type="hidden" />
    <input asp-for="SectionId" type="hidden" />
    <input asp-for="DisplayOrder" type="hidden" class="row-display-order" />    
    <input type="hidden"
       name="@Html.NameFor(m => m.RowState)"
       value="@((int)Model.RowState)"
       class="row-state" />
       
    <td class="action-cell text-center">
        <button type="button"
                class="btn btn-sm btn-outline-danger delete-line"
                data-rowid="@Model.RowId">

            <i class="bi bi-trash"></i>
        </button>
    </td>

    <td class="line-number">
        <span class="line-no">
            @Model.RowNumber
        </span>
    </td>

    @for (int i = 0; i < Model.Fields.Count; i++)
    {
        var field = Model.Fields[i];

        if (!string.IsNullOrWhiteSpace(field.MergeWith))
        {
            // Retain the editor for MVC form binding, but do not show
            // a separate table column for this merged field.
            <td class="field-cell merged-field-cell"
                data-field-code="@field.FieldCode"
                data-merge-with="@field.MergeWith"
                style="display:none">

                @Html.EditorFor(m => m.Fields[i])

            </td>
        }
        else
        {
            var mergedField = Model.Fields.FirstOrDefault(f =>
                string.Equals(
                    f.MergeWith?.Trim(),
                    field.FieldCode?.Trim(),
                    StringComparison.OrdinalIgnoreCase));

            <td class="field-cell"
                data-field-code="@field.FieldCode">

                @Html.EditorFor(m => m.Fields[i])

                @if (mergedField != null)
                {
                    <div class="merged-field-display text-muted small"
                        data-merge-with="@field.FieldCode">
                        @mergedField.FieldValue
                    </div>
                }
            </td>
        }
    
    }

</tr>