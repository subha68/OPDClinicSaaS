@model ViewModels.PrescriptionVM

@using Models

<div class="prescription-sheet">

    <!-- HEADER -->
    <table class="rx-header-table">
        <tr>

            <!-- LEFT: Doctor, Patient & Appointment -->
            <td class="left-panel">

                <div class="doctor-line">
                    <span class="doctor-name">@Model.DoctorName</span>
                    <span class="doctor-reg">
                        Reg No: @Model.RegistrationNumber
                    </span>
                </div>

                <div class="doctor-qualification">
                    @Model.Qualification
                </div>

                <div class="patient-block">

                    <div class="patient-name">
                        Patient ID: @Model.PatientId |
                        Name: @Model.PatientName
                    </div>

                    <div class="patient-meta">
                        Age: @Model.Age |
                        Gender: @Model.Gender |
                        Ph: @Model.PatientPhoneNo
                    </div>

                    <div class="visit-datetime">
                        Appointment:
                        @Model.VisitDateTime.ToString("dd/MM/yyyy")
                        &nbsp;|&nbsp;
                        @Model.VisitDateTime.ToString("HH:mm")
                    </div>

                </div>

            </td>


            <!-- RIGHT: Clinic Branding & Contact -->
            <td class="right-panel">

                @if (!string.IsNullOrEmpty(Model.ClinicLogo))
                {
                    <div class="clinic-logo">
                        <img src="@Url.Content("~/images/" + Model.ClinicLogo)"
                            alt="Clinic Logo" />
                    </div>
                }

                <div class="clinic-name">
                    @Model.ClinicName
                </div>

                <div class="clinic-address">
                    @Model.ClinicAddress
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ClinicPhoneNo))
                {
                    <div class="clinic-phone">
                        Ph: @Model.ClinicPhoneNo
                    </div>
                }

            </td>

        </tr>
    </table>

    <hr class="soft-divider" />

    <!-- BODY -->

    @if (Model.Sections != null)
    {
        foreach (var consultationSection in Model.Sections.OrderBy(s => s.DisplayOrder))
        {
            if (!consultationSection.IsVisible)
            {
                continue;
            }

            <section class="consultation-section">

                <h5>@consultationSection.SectionName</h5>

                @if (consultationSection.IsVital &&
                    consultationSection.Rows?.Any() == true &&
                    consultationSection.Rows[0].Vitals?.Any() == true)
                {
                    <div class="prescription-vitals">

                        @for (int i = 0; i < consultationSection.Rows[0].Vitals.Count; i++)
                        {
                            var vital = consultationSection.Rows[0].Vitals[i];

                            if (!vital.IsCompositionItem)
                            {
                                <span>
                                    @vital.VitalCode:
                                    @vital.VitalValue

                                    @if (!string.IsNullOrWhiteSpace(vital.VitalUnit))
                                    {
                                        @($" {vital.VitalUnit}")
                                    }
                                </span>

                                @if (i < consultationSection.Rows[0].Vitals.Count - 1)
                                {
                                    <span> , </span>
                                }
                            }
                        }

                    </div>
                }

                @if (consultationSection.IsTestResult &&
                    consultationSection.Rows?.Any() == true &&
                    consultationSection.Rows[0].TestResults?.Any() == true)
                {
                    var groupedResults = consultationSection.Rows[0].TestResults
                        .OrderByDescending(x => x.TestDate)
                        .GroupBy(x => x.TestDate.Date);

                    <div class="prescription-test-results">

                        @foreach (var testDateGroup in groupedResults)
                        {
                            <div class="test-result-line">

                                <span class="test-date">
                                    @testDateGroup.Key.ToString("dd/MM/yyyy")
                                </span>

                                <span> : </span>

                                @for (int i = 0; i < testDateGroup.Count(); i++)
                                {
                                    var result = testDateGroup.ElementAt(i);

                                    <span>
                                        @result.TestParameterCode
                                        @(" ")
                                        @result.Value

                                        @if (!string.IsNullOrWhiteSpace(result.Unit))
                                        {
                                            @(" ")
                                            @result.Unit
                                        }
                                    </span>

                                    @if (i < testDateGroup.Count() - 1)
                                    {
                                        <span> , </span>
                                    }
                                }

                            </div>
                        }

                    </div>
                }               

                @if (consultationSection.Multiline)
                {
                    <!-- ========================= -->
                    <!-- Generic tabular section -->
                    <!-- ========================= -->

                    var orderedRows = consultationSection.Rows
                        .OrderBy(r => r.DisplayOrder)
                        .ToList();

                    var headerFields = orderedRows
                        .FirstOrDefault()?
                        .Fields
                        .OrderBy(f => f.DisplayOrder)
                        .ToList();

                    if (headerFields != null && headerFields.Any())
                    {
                        <table class="table table-bordered prescription-table">
                            <thead>
                                <tr>
                                    <th>#</th>

                                    @foreach (var field in headerFields)
                                    {
                                        <th>@field.FieldLabel</th>
                                    }
                                </tr>
                            </thead>

                            <tbody>

                                @{
                                    int rowNo = 1;
                                }

                                @foreach (var row in orderedRows)
                                {
                                    <tr>
                                        <td>@rowNo</td>

                                        @foreach (var field in row.Fields)
                                        {
                                            //var field = row.Fields
                                            //    .FirstOrDefault(f => f.FieldId == headerField.FieldId);

                                            <td>
                                                @field?.FieldValue
                                            </td>
                                        }
                                    </tr>

                                    rowNo++;
                                }

                            </tbody>
                        </table>
                    }
                }
                else
                {
                    <!-- ========================= -->
                    <!-- GENERIC CONSULTATION DATA -->
                    <!-- ========================= -->

                    @foreach (var row in consultationSection.Rows.OrderBy(r => r.DisplayOrder))
                    {
                        <div class="consultation-row">

                            @foreach (var field in row.Fields.OrderBy(f => f.DisplayOrder))
                            {
                                var selectedOptions = field.Options
                                                            // .Where(o => o.IsSelected)
                                                                .OrderBy(o => o.DisplayOrder)
                                                                .ToList();

                                var hasValue =
                                    !string.IsNullOrWhiteSpace(field.FieldValue);

                                if (!hasValue && !selectedOptions.Any())
                                {
                                    continue;
                                }

                                <div class="consultation-field">

                                    <span class="field-label">
                                        @field.FieldLabel
                                    </span>

                                    <span class="field-value">

                                        @if (hasValue)
                                        {
                                            @field.FieldValue
                                        }

                                        @if (selectedOptions.Any())
                                        {
                                            @if (hasValue)
                                            {
                                                <text> </text>
                                            }

                                            @string.Join(", ",
                                                selectedOptions.Select(o => o.OptionText))
                                        }

                                    </span>

                                </div>
                            }

                        </div>
                    }
                }
            </section>
        }
    }


    <!-- SIGNATURE -->

    <div class="signature-block">
        ___________________________

        <div class="signature-name">
            @Model.DoctorName
        </div>

        <div class="signature-qualification">
            @Model.Qualification
        </div>
    </div>

    <hr class="soft-divider" />


    <!-- FOOTER -->

    <footer class="rx-footer">
        This prescription is valid only with physician signature.
        Follow dosage instructions carefully.
        Contact your doctor immediately in case of any adverse reaction.
    </footer>
</div>

<!-- PRINT BUTTONS -->

<div class="print-buttons">

    <button onclick="window.print()"
            class="btn btn-primary">

        <i class="fa fa-print"></i>
        Print

    </button>

    <a asp-controller="Consultation" 
            asp-action="Index" 
            class="btn btn-secondary"> 
            
        <i class="fa fa-arrow-left"></i> 
        Back 
        
    </a>

</div>