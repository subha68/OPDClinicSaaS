@model Models.ConsultationSection

<div class="table-responsive">  

    <table class="table table-bordered table-hover consultation-grid"
           data-section-id="@Model.SectionId"
           data-rx="@Model.IsPharmacologyAdvice.ToString().ToLower()">

        <thead>

            <tr>

                <th class="action-column">
                    Action
                </th>

                <th class="line-no-column">
                    #
                </th>

@if (Model == null)
{
    throw new Exception("Model is NULL");
}

@if (Model.TemplateRow == null)
{
    throw new Exception(
        $"TemplateRow is NULL. Section = {Model.SectionName}");
}

@if (Model.TemplateRow.Fields == null)
{
    throw new Exception(
        $"Fields collection is NULL. Section = {Model.SectionName}");
}

                @foreach (var field in Model.TemplateRow.Fields
                    .Where(f => f.FieldTypeCode != "Hidden")
                    .OrderBy(f => f.DisplayOrder))
                {
                    <th>

                        @field.FieldLabel

                        @if (field.IsMandatory)
                        {
                            <span class="text-danger">*</span>
                        }

                    </th>
                }

            </tr>

        </thead>


        <tbody class="consultation-body"
               data-section-id="@Model.SectionId">

            @{
                var orderedRows = Model.Rows
                    .OrderBy(r => r.RowNumber)
                    .ToList();
            }

            @for (int rowIndex = 0; rowIndex < orderedRows.Count; rowIndex++)
            {
                var row = orderedRows[rowIndex];

                var vd = new ViewDataDictionary(ViewData);

                vd.TemplateInfo.HtmlFieldPrefix =
                    ViewData.TemplateInfo.GetFullHtmlFieldName(
                        $"Rows[{rowIndex}]");

                vd["IsTemplate"] = false;

                <partial name="_MultilineRow"
                         model="row"
                         view-data="vd" />
            }

        </tbody>


        <!-- TEMPLATE ROW -->
        <tbody class="consultation-template d-none">

            @{
                var vdTemplate = new ViewDataDictionary(ViewData);

                vdTemplate.TemplateInfo.HtmlFieldPrefix =
                    ViewData.TemplateInfo.GetFullHtmlFieldName(
                        "TemplateRow");

                vdTemplate["IsTemplate"] = true;
            }

            <partial name="_MultilineRow"
                     model="Model.TemplateRow"
                     view-data="vdTemplate" />

        </tbody>


        <tfoot>

            <tr>

                <td colspan="@(Model.TemplateRow.Fields.Count + 2)">

                    <button type="button"
                            class="btn btn-outline-primary btn-sm add-line"
                            data-section-id="@Model.SectionId">

                        <i class="bi bi-plus-circle"></i>
                        Add Line

                    </button>

                </td>

            </tr>

        </tfoot>

    </table>

</div>
