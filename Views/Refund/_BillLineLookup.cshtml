@model List<Models.BillLine>

<table class="table table-hover">

    <thead>

        <tr>
            <th>Line</th>
            <th>Description</th>
            <th class="text-end">Qty</th>
            <th class="text-end">Rate</th>
            <th class="text-end">Net Amount</th>
            <th></th>
        </tr>

    </thead>

    <tbody>

        @foreach(var line in Model)
        {
            <tr>

                <td>@line.LineId</td>

                <td>@line.Description</td>

                <td class="text-end">
                    @line.Quantity
                </td>

                <td class="text-end">
                    @line.Rate.ToString("N2")
                </td>

                <td class="text-end">
                    @line.NetAmount.ToString("N2")
                </td>

                <td>

                    <button type="button"
                            class="btn btn-sm btn-primary"
                            onclick="addBillLine(@line.LineId)">

                        Select

                    </button>

                </td>

            </tr>
        }

    </tbody>

</table>