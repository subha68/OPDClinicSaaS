@model ViewModels.RefundApprovalVM

@using Models
@using Helpers

@{
    ViewData["Title"] = "Refund Approval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                Refund Approval
            </h5>

        </div>

        <div class="card-body">

            <div id="refundApprovalContainer">

                @* =========================================================
                No Refunds Awaiting Approval
                ========================================================= *@

                @if (Model.PendingRefunds == null ||
                    !Model.PendingRefunds.Any())
                {
                    <div class="alert alert-info mb-0">

                        <i class="fa-solid fa-circle-info me-2"></i>

                        No refunds are awaiting approval.

                    </div>
                }

                @* =========================================================
                Exactly One Refund
                Render Approval Details directly
                ========================================================= *@

                else if (Model.PendingRefunds.Count == 1)
                {
                    @if (Model.SelectedRefund != null)
                    {
                        @await Html.PartialAsync(
                            "_RefundApprovalDetails",
                            Model.SelectedRefund)
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">

                            <i class="fa-solid fa-triangle-exclamation me-2"></i>

                            Unable to load the refund awaiting approval.

                        </div>
                    }
                }

                @* =========================================================
                Multiple Refunds
                ========================================================= *@

                else
                {
                    @await Html.PartialAsync("_RefundApprovalList", Model.PendingRefunds)
                }

            </div>

        </div>

    </div>

</div>

<div class="modal fade"
     id="refundRejectModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Reject Refund
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <div class="modal-body">

                <div id="refundRejectionValidation"
                     class="alert alert-danger d-none">
                </div>

                <label for="RefundRejectionReason"
                       class="form-label">
                    Rejection Reason
                    <span class="text-danger">*</span>
                </label>

                <textarea id="RefundRejectionReason"
                          class="form-control"
                          rows="4"
                          maxlength="500"
                          placeholder="Enter reason for rejecting this refund...">
                </textarea>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="btnConfirmRejectRefund"
                        class="btn btn-danger">
                    <i class="fa-solid fa-ban me-1"></i>
                    Reject
                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/refund/refund-approval.js" asp-append-version="true"></script>
}