@model List<Models.Refund>

@using Models
@using Helpers

<div class="table-responsive">

    <table class="table table-hover align-middle mb-0">

        <thead class="table-light">

            <tr>

                <th>
                    Refund No
                </th>

                <th>
                    Refund Date
                </th>

                <th>
                    Patient
                </th>

                <th>
                    Bill No
                </th>

                <th class="text-end">
                    Refund Amount
                </th>

                <th>
                    Reason
                </th>

                <th class="text-center"
                    style="width:100px;">

                    Action

                </th>

            </tr>

        </thead>

        <tbody>

            @if (Model == null || !Model.Any())
            {
                <tr>

                    <td colspan="7"
                        class="text-center text-muted py-4">

                        No refunds are awaiting approval.

                    </td>

                </tr>
            }
            else
            {
                foreach (var refund in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @refund.RefundNo
                            </strong>
                        </td>

                        <td>
                            @refund.RefundDate.ToString("dd-MMM-yyyy")
                        </td>

                        <td>
                            @refund.PatientName
                        </td>

                        <td>
                            @refund.BillNo
                        </td>

                        <td class="text-end">

                            <strong>
                                @refund.NetAmount.ToString("N2")
                            </strong>

                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(refund.Reason))
                            {
                                <span>
                                    @refund.Reason
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    —
                                </span>
                            }
                        </td>

                        <td class="text-center">

                            <button type="button"
                                    class="btn btn-outline-primary btn-sm btn-view-refund"
                                    data-refund-id="@refund.RefundId">

                                <i class="fa-solid fa-eye me-1"></i>
                                View

                            </button>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>