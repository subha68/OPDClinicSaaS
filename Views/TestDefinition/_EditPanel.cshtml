@model Models.TestPanel

<div class="panel-editor card border-primary">

    <form id="testPanelForm"
        method="post"
        action="@Url.Action("AddPanel","TestDefinition")">

        @Html.AntiForgeryToken()

        <input type="hidden"
            id="Panel_TestPanelId"
            name="TestPanelId"
            value="@Model.TestPanelId" />

        <div class="card-body">

            <!-- ==========================================
                FIRST ROW
                ========================================== -->

            <div class="row align-items-end g-2">

                <div class="col-md-1">

                    <label class="form-label small mb-1">
                        Code
                    </label>

                    <input type="text"
                        id="Panel_Code"
                        class="form-control form-control-sm"
                        name="Code"
                        value="@Model.Code"
                        maxlength="50" />

                </div>

                <div class="col-md-3">

                    <label class="form-label small mb-1">
                        Panel
                    </label>

                    <input type="text"
                        id="Panel_Name"
                        class="form-control form-control-sm"
                        name="Name"
                        value="@Model.Name"
                        maxlength="200" />

                </div>

                <div class="col-md-2">

                    <label class="form-label small mb-1">
                        Department
                    </label>

                    <input type="text"
                        id="Panel_DepartmentName"
                        class="form-control form-control-sm"
                        name="DepartmentName"
                        value="@Model.DepartmentName"
                        maxlength="200" />

                </div>

                <div class="col-md-1">

                    <label class="form-label small mb-1">
                        Order
                    </label>

                    <input type="number"
                        id="Panel_DisplayOrder"
                        class="form-control form-control-sm"
                        name="DisplayOrder"
                        min="1"
                        value="@Model.DisplayOrder" />

                </div>

                <div class="col-md-1 text-center">

                    <label class="form-label small mb-1 d-block">
                        Active
                    </label>

                    <input asp-for="IsActive"
                        class="form-check-input" />

                </div>

                <div class="col-md-4 text-end">

                    <button type="submit"
                            class="btn btn-sm btn-success btn-save-panel">

                        <i class="fa fa-save me-1"></i>
                        Save

                    </button>

                    <button type="button"
                            class="btn btn-sm btn-secondary btn-cancel-panel-edit">

                        <i class="fa fa-times me-1"></i>
                        Cancel

                    </button>

                </div>

            </div>

            <!-- ==========================================
                DESCRIPTION
                ========================================== -->

            <div class="row mt-2">

                <div class="col">

                    <label class="form-label small mb-1">
                        Description
                    </label>

                    <input type="text"
                        id="Panel_Description"
                        class="form-control form-control-sm"
                        value="@Model.Description"
                        maxlength="500" />

                </div>

            </div>

        </div>
    </form>

</div>