@model ViewModels.BillingCreateVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Create Bill";
}

<form asp-action="Create" 
        method="post" 
        id="billForm"
        data-get-billing-context-url="@Url.Action("GetBillingContext", "Billing")"
        data-get-previous-bills-url="@Url.Action("GetPreviousBills", "Billing")" >

    <input type="hidden" asp-for="Bill.BillType" value="Service" />
    <input type="hidden" asp-for="Bill.PatientId" id="PatientId" />
    <input type="hidden" asp-for="Bill.VisitId" id="VisitId" />
    <input type="hidden" asp-for="Bill.AppointmentId" id="AppointmentId" />

    <div class="row mb-3">

        <div class="col-md-3">
            <label asp-for="Bill.BillDate" class="form-label">
                Date
            </label>

            <input asp-for="Bill.BillDate"
                   type="date"
                   class="form-control"
                   id="BillDate" />
        </div>

        <div class="col-md-5">
            <label class="form-label">
                Patient
            </label>

            <input type="text"
                   id="PatientSearch"
                   class="form-control"
                   placeholder="Search patient by name, mobile or UHID"
                   autocomplete="off"
                   value="@Model.Bill.PatientName" />
        </div>

        <div class="col-md-4">

            <div id="doctorContainer"
                style="display:none;"
                data-appointment-id="@Model.Bill.AppointmentId"
                data-doctor-id="@Model.Bill.DoctorId"
                data-doctor-name="@(
                    Model.Bill.Doctor != null
                        ? $"{Model.Bill.Doctor.FirstName} {Model.Bill.Doctor.LastName}".Trim()
                        : ""
                )">

                <label class="form-label">
                    Doctor
                </label>

                <!-- Used when there is exactly one appointment -->
                <input type="text"
                    id="DoctorDisplay"
                    class="form-control"
                    readonly
                    style="display:none;" />

                <!-- Used when there are multiple appointments -->
                <select id="DoctorId"
                        class="form-select"
                        style="display:none;">
                    <option value="">-- select doctor --</option>
                </select>

            </div>

        </div>

    </div>


    <div id="billingContextMessage"
         class="text-muted small mb-3"
         style="display:none;">
    </div>


    <hr />


    <table class="table" id="billTable">

        <thead>
            <tr>
                <th>Description</th>
                <th>Rate</th>
                <th>Qty</th>
                <th>Disc %</th>
                <th>Net</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        </tbody>

    </table>


    <button type="button"
            class="btn btn-primary"
            id="addLine">
        Add Charge
    </button>


    <hr />


    <div class="mb-3">

        <label class="form-label">
            Total
        </label>

        <input id="Total"
               class="form-control"
               readonly />

    </div>


    <div class="d-flex gap-2">

        <button type="submit"
                class="btn btn-success"
                id="saveBill">
            Save Bill
        </button>

        <button type="button"
                class="btn btn-outline-secondary"
                id="previousBillsButton"
                data-bs-toggle="modal"
                data-bs-target="#previousBillsModal"
                style="display:none;">

            Previous Bills

            <span class="badge bg-secondary ms-1"
                id="previousBillsCount">
                0
            </span>

        </button>

    </div>


</form>


<div class="modal fade"
        id="previousBillsModal"
        tabindex="-1"
        aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Previous Bills
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div id="previousBillsLoading"
                        class="text-center py-4">

                    <div class="spinner-border spinner-border-sm me-2">
                    </div>

                    Loading bills...

                </div>

                <div id="previousBillsContent">
                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script src="~/js/billing/create-bill.js" asp-append-version="true"></script>

}
