@model Models.Bill

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    const int linesPerPage = 7;

    var lineCount = Model.BillLines?.Count ?? 0;

    var pageCount =
        Math.Max(
            1,
            (int)Math.Ceiling(
                lineCount / (double)linesPerPage
            )
        );
}

<div class="container mt-4">

    <input type="hidden"
           name="BillId"
           id="BillId"
           value="@Model.BillId" />


    <!-- =====================================================
         SCREEN-ONLY CONTROLS
         ===================================================== -->

    <div class="mb-3 text-end no-print">

        <button onclick="window.print()"
                class="btn btn-primary">
            Print Bill
        </button>

        @if (Model.PaymentStatus != "Paid")
        {
            <a asp-controller="Payment"
               asp-action="Pay"
               asp-route-id="@Model.BillId"
               class="btn btn-primary">
                Pay
            </a>
        }

        @if (ViewBag.ReturnUrl is string returnUrl)
        {
            <a href="@returnUrl"
            class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Back to Patient History
            </a>
        }
        else
        {
            @await Html.PartialAsync(
                "_BackButton",
                new ViewModels.BackButtonVM
                {
                    Controller = "Billing",
                    Action = "SearchByPatient",
                    PatientId = Model.PatientId,
                    Text = "Back to Bills"
                }
            )
        }

    </div>


    <!-- =====================================================
         PRINT AREA
         ===================================================== -->

    <div id="billArea">

        @for (
            int page = 0;
            page < pageCount;
            page++
        )
        {
            var pageStart =
                page * linesPerPage;

            var pageEnd =
                Math.Min(
                    pageStart + linesPerPage,
                    lineCount
                );

            var isLastPage =
                page == pageCount - 1;


            <!-- =================================================
                 HALF-A4 PAGE
                 ================================================= -->

            <div class="bill-print-page">

                <div class="bill-container">


                    <!-- =============================================
                         CLINIC HEADER
                         ============================================= -->

                    <div class="bill-clinic-header">

                        <div class="bill-clinic-name">
                            @Model.Clinic?.Name
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                            Model.Clinic?.Address))
                        {
                            <div class="bill-clinic-address">
                                @Model.Clinic.Address
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(
                            Model.Clinic?.Phone))
                        {
                            <div class="bill-clinic-phone">
                                @Model.Clinic.Phone
                            </div>
                        }

                        <div class="bill-title">
                            BILL
                        </div>

                    </div>


                    <!-- =============================================
                         PATIENT + BILL DETAILS
                         ============================================= -->

                    <div class="bill-header-grid">


                        <!-- Patient -->

                        <div class="bill-info-block">

                            <div class="bill-info-row">

                                <span class="bill-label">
                                    Patient
                                </span>

                                <span class="bill-value">
                                    @Model.Patient?.FirstName
                                    @Model.Patient?.LastName
                                </span>

                            </div>


                            <div class="bill-info-row">

                                <span class="bill-label">
                                    Visit Date
                                </span>

                                <span class="bill-value">
                                    @(Model.VisitDate?.ToString("dd-MMM-yyyy") ?? "")
                                </span>

                            </div>


                            @if (
                                Model.Doctor != null &&
                                !string.IsNullOrWhiteSpace(
                                    Model.Doctor.DoctorName))
                            {
                                <div class="bill-info-row">

                                    <span class="bill-label">
                                        Doctor
                                    </span>

                                    <span class="bill-value">
                                        @Model.Doctor.DoctorName
                                    </span>

                                </div>
                            }

                        </div>


                        <!-- Bill -->

                        <div class="bill-info-block">

                            <div class="bill-info-row">

                                <span class="bill-label">
                                    Bill No
                                </span>

                                <span class="bill-value">
                                    @Model.BillNo
                                </span>

                            </div>


                            <div class="bill-info-row">

                                <span class="bill-label">
                                    Bill Date
                                </span>

                                <span class="bill-value">
                                    @Model.BillDate.ToString("dd-MMM-yyyy")
                                </span>

                            </div>


                            <div class="bill-info-row">

                                <span class="bill-label">
                                    Status
                                </span>

                                <span class="bill-value">
                                    @Model.PaymentStatus
                                </span>

                            </div>

                        </div>

                    </div>


                    <!-- =============================================
                         BILL LINES
                         ============================================= -->

                    <table class="bill-lines-table">

                        <colgroup>

                            <col class="col-sl" />
                            <col class="col-charge" />
                            <col class="col-rate" />
                            <col class="col-quantity" />
                            <col class="col-gross" />
                            <col class="col-discount-percent" />
                            <col class="col-discount" />
                            <col class="col-net" />

                        </colgroup>


                        <thead>

                            <tr>

                                <th>#</th>

                                <th>
                                    Charge
                                </th>

                                <th class="text-end">
                                    Rate
                                </th>

                                <th class="text-end">
                                    Qty
                                </th>

                                <th class="text-end">
                                    Gross
                                </th>

                                <th class="text-end">
                                    Disc %
                                </th>

                                <th class="text-end">
                                    Discount
                                </th>

                                <th class="text-end">
                                    Net
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @for (
                                int i = pageStart;
                                i < pageEnd;
                                i++
                            )
                            {
                                var line =
                                    Model.BillLines.ElementAt(i);

                                <tr>

                                    <td>
                                        @(i + 1)
                                    </td>

                                    <td>
                                        @line.Description
                                    </td>

                                    <td class="text-end">
                                        @line.Rate.ToString("0.00")
                                    </td>

                                    <td class="text-end">
                                        @line.Quantity
                                    </td>

                                    <td class="text-end">
                                        @line.GrossAmount.ToString("0.00")
                                    </td>

                                    <td class="text-end">
                                        @line.DiscountPercent.ToString("0.00")%
                                    </td>

                                    <td class="text-end">
                                        @line.DiscountAmount.ToString("0.00")
                                    </td>

                                    <td class="text-end">
                                        @line.NetAmount.ToString("0.00")
                                    </td>

                                </tr>
                            }

                        </tbody>


                        <!-- =========================================
                             TOTAL — FINAL PAGE ONLY
                             ========================================= -->

                        @if (isLastPage)
                        {
                            <tfoot>

                                <tr>

                                    <th></th>

                                    <th class="text-end">
                                        Total
                                    </th>

                                    <th></th>

                                    <th></th>

                                    <th class="text-end">
                                        @Model.GrossAmount.ToString("0.00")
                                    </th>

                                    <th></th>

                                    <th class="text-end">
                                        @Model.DiscountAmount.ToString("0.00")
                                    </th>

                                    <th class="text-end">
                                        @Model.NetAmount.ToString("0.00")
                                    </th>

                                </tr>

                            </tfoot>
                        }

                    </table>


                    <!-- =============================================
                         FINAL PAGE INFORMATION
                         ============================================= -->

                    @if (isLastPage)
                    {

                        <!-- Amount in Words -->

                        <div class="bill-amount-words">

                            <strong>
                                Amount in Words:
                            </strong>

                            @Model.AmountInWords

                        </div>


                        <!-- Payments -->

                        @if (
                            Model.Payments != null &&
                            Model.Payments.Count > 0
                        )
                        {

                            <table class="bill-payments-table">

                                <thead>

                                    <tr>

                                        <th>
                                            Date
                                        </th>

                                        <th>
                                            Mode
                                        </th>

                                        <th>
                                            Reference
                                        </th>

                                        <th class="text-end">
                                            Amount
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (
                                        var p in Model.Payments)
                                    {
                                        <tr>

                                            <td>
                                                @p.PaymentDate.ToString("dd-MMM-yyyy")
                                            </td>

                                            <td>
                                                @p.Mode
                                            </td>

                                            <td>
                                                @p.ReferenceNo
                                            </td>

                                            <td class="text-end">
                                                @p.Amount.ToString("0.00")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>


                            <div class="bill-payment-summary">

                                <div>
                                    Total Paid:
                                    <strong>
                                        @Model.TotalPaidAmount.ToString("0.00")
                                    </strong>
                                </div>

                                <div>
                                    Balance:
                                    <strong>
                                        @Model.BalanceAmount.ToString("0.00")
                                    </strong>
                                </div>

                            </div>

                        }

                    }


                    <!-- =============================================
                         FOOTER — EVERY HALF-A4 PAGE
                         ============================================= -->

                    <div class="bill-footer">

                        <span>
                            This is a computer generated bill.
                        </span>

                        <span>
                            Authorized Signatory
                        </span>

                    </div>

                </div>

            </div>
        }

    </div>

</div>


@section Styles {

    <link rel="stylesheet" href="~/css/billing/bill-print.css" asp-append-version="true" />
}


@section Scripts {

    <script>
        function payBill() {

            var billId =
                $("#BillId").val();

            window.location =
                '/Payment/Pay?id=' +
                billId;
        }
    </script>

}