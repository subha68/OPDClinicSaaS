@model IEnumerable<Models.Bill>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewBag.PageTitle = "Patient Bills";

    ViewBag.CustomHeaderActions = new []
    {
        new { Label="+ Add New Bill", Controller = "Billing", Action = "Create" }
    };

    ViewBag.KeyField = "BillId";

    ViewBag.Fields = new []
    {
        new { Name="VisitDate", Label="Visit Date", Type="date", Color=""},
        new { Name="PatientId", Label="Patient Id", Type="text", Color=""},
        new { Name="PatientName", Label="Patient Name", Type="text", Color=""},
        new { Name="BillDate", Label="Bill Date", Type="date", Color="" },
        new { Name="NetAmount", Label="Bill Amount", Type="number", Color="" },
        new { Name="TotalPaidAmount", Label="Paid Amount", Type="number", Color="" },
        new { Name="BalanceAmount", Label="Due Amount", Type="number", Color="" },
        new { Name="PaymentStatus", Label="Status", Type="text", Color="StatusColor" }
    };

    ViewBag.ColorFunctions = new Dictionary<string, Func<dynamic, string>>
    {
        {"StatusColor", row => {
                                        string status = row.PaymentStatus as string;

                                        return status switch
                                        {
                                            "Paid" => "green",
                                            "Due" => "red",
                                            "Partially Paid" => "orange",
                                            _ => ""
                                        };
                                    }
        }
    };

    ViewBag.CheckFunctions = new Dictionary<string, Func<dynamic, bool>>
    {
        {"StatusCheck", row => {
                                        string status = row.PaymentStatus as string;

                                        return status != "Paid";
                                    }
        }
    };

    ViewBag.CustomLineActions = new []
    {
        new { Label = "View Bill", Controller = "Billing", Action = "Print", Type = "info", condition="" },
        new { Label = "Pay", Controller = "Payment", Action = "Pay", Type = "success", condition = "StatusCheck" }
    };

    ViewBag.SearchFields = new[]
    {
        "PatientId",
        "PatientName",
        "BillDate",
        "PaymentStatus"
    };

    ViewBag.PageSize = 10;

}

@await Html.PartialAsync("_CrudList", Model)