@model ViewModels.TestResultGroupVM

<form id="testResultForm"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="TestResultGroupId" type="hidden" />
    <input asp-for="ClinicId" type="hidden" />
    <input asp-for="PatientId" type="hidden" />

    <div class="card mb-3">

        <div class="card-header">

            <strong>
                Report Information
            </strong>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-3">

                    <label asp-for="VisitId"
                           class="form-label">
                        Visit Date
                    </label>
                    
                    <select asp-for="VisitId" 
                            class="form-select" >

                        @if (Model.Visits != null)
                        {
                            foreach (var visit in Model.Visits)
                            {
                                <option value="@visit.VisitId">
                                    @visit.VisitDate.ToString("dd-MMM-yyyy")
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="col-md-3">

                    <label asp-for="TestDate"
                           class="form-label">
                        Test Date
                    </label>

                    <input asp-for="TestDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label asp-for="ResultDate"
                           class="form-label">
                        Result Date
                    </label>

                    <input asp-for="ResultDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label asp-for="ReportNo"
                           class="form-label">
                        Report No
                    </label>

                    <input asp-for="ReportNo"
                           class="form-control" />

                </div>

                <div class="col-md-6">

                    <label asp-for="LabName"
                           class="form-label">
                        Laboratory
                    </label>

                    <input asp-for="LabName"
                           class="form-control" />

                </div>

                <div class="col-md-6">

                    <label asp-for="Remarks"
                           class="form-label">
                        Remarks
                    </label>

                    <input asp-for="Remarks"
                           class="form-control" />

                </div>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- RESULTS -->
    <!-- ===================================================== -->

    <div class="card">

        <div class="card-header d-flex justify-content-between align-items-center">

            <strong>
                Test Results
            </strong>

            <button type="button"
                    id="btnAddResultRow"
                    class="btn btn-sm btn-primary">

                <i class="fa-solid fa-plus me-1"></i>

                Add Parameter

            </button>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-sm table-bordered align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width:220px;">
                                Test Parameter
                            </th>

                            <th style="width:180px;">
                                Panel
                            </th>

                            <th style="width:140px;">
                                Normal Range
                            </th>

                            <th style="width:120px;">
                                Value
                            </th>

                            <th style="width:140px;">
                                Previous Value
                            </th>

                            <th style="width:90px;">
                                Unit
                            </th>

                            <th style="width:120px;">
                                Flag
                            </th>

                            <th style="width:60px;">
                            </th>

                        </tr>

                    </thead>

                    <tbody id="resultRows">

                        @if (Model.Results.Any())
                        {
                            for (int i = 0; i < Model.Results.Count; i++)
                            {
                                @await Html.PartialAsync(
                                    "_ResultRow",
                                    Model.Results[i],
                                    new ViewDataDictionary(
                                        ViewData)
                                    {
                                        ["Index"] = i
                                    })
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- ===================================================== -->
    <!-- FOOTER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-end gap-2 mt-3">

        <button type="button"
                id="btnBackToReports"
                class="btn btn-secondary">

            <i class="fa-solid fa-arrow-left me-1"></i>

            Back

        </button>

        <button type="submit"
                id="btnSaveReport"
                class="btn btn-success">

            <i class="fa-solid fa-save me-1"></i>

            Save

        </button>

    </div>

</form>