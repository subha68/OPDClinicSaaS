@model Models.Doctor

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit =
        Model != null &&
        Model.DoctorId > 0;

    ViewBag.PageTitle = isEdit ? "Edit Doctor" : "Create Doctor";

    ViewBag.Fields = new[]
    {
        new { Name="Salutation", Label="Salutation", Type="text", Col="2"},
        new { Name="FirstName", Label="First Name", Type="text", Col="5"},
        new { Name="LastName", Label="Last Name", Type="text", Col="5"},
        new { Name="DepartmentId", Label="Department", Type="dropdown", Col="6"},
        new { Name="RegistrationNo", Label="Registration No", Type="text", Col="6"},
        new { Name="Qualification", Label="Qualification", Type="text", Col="12"},
        new { Name="Phone", Label="Phone", Type="text", Col="6"},
        new { Name="Email", Label="Email", Type="text", Col="6"},
        new { Name="Username", Label="User Name", Type="text", Col="6"},
        new { Name="Password", Label="Password", Type="password", Col="6"}
    };

    ViewBag.Dropdowns = new Dictionary<string, object>()
    {
        { "DepartmentId", ViewBag.Departments }
    };

    ViewBag.KeyField = "DoctorId";
}

@await Html.PartialAsync("_CrudForm", Model)
