@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model ViewModels.DoctorVM

<h2>Create Doctor</h2>

@using (Html.BeginForm())
{
    <div>First Name: @Html.TextBoxFor(m => m.FirstName)</div>
    <div>Last Name: @Html.TextBoxFor(m => m.LastName)</div>

    <div>
        Department:
        @Html.DropDownListFor(m => m.DepartmentId, Model.Departments, "--Select--")
    </div>

    <div>Registration No: @Html.TextBoxFor(m => m.RegistrationNo)</div>
    <div>Qualification: @Html.TextBoxFor(m => m.Qualification)</div>

    <button type="submit">Save</button>
}