@model IEnumerable<Models.Doctor>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Doctor Management";

    ViewBag.PageTitle = "Doctor Management";

    ViewBag.Columns = new[] { "First Name", "Last Name", "Department", "Registration No", "Qualification", "Username", "Password", "Clinic" };
    ViewBag.Properties = new[] { "FirstName", "LastName", "DepartmentName", "RegistrationNo", "Qualification", "Username", "Password", "ClinicName" };

    ViewBag.KeyField = "DoctorId";
}

@await Html.PartialAsync("_CrudList", Model)
