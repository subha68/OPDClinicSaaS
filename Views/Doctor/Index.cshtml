@model IEnumerable<Models.Doctor>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Doctor Management";

    ViewBag.PageTitle = "Doctor Management";

    ViewBag.Fields = new []
    {
        new { Name="FirstName", Label="First Name", Type="text", Color="" },
        new { Name="LastName", Label="Last Name", Type="text", Color="" },
        new { Name="DepartmentName", Label="Department", Type="text", Color="" },
        new { Name="RegistrationNo", Label="Registration No", Type="text", Color="" },
        new { Name="Qualification", Label="Qualification", Type="text", Color="" },
        new { Name="Username", Label="Username", Type="text", Color="" },
        new { Name="Password", Label="Password", Type="password", Color="" },
        new { Name="ClinicName", Label="Clinic", Type="text", Color="" }
    };

    ViewBag.KeyField = "DoctorId";
}

@await Html.PartialAsync("_CrudList", Model)
