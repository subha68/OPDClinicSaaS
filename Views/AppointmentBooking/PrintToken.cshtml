@model Models.Appointment

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>Appointment Token</title>

    <link rel="stylesheet"
          href="~/css/print-token.css" />

</head>

<body>

    <div class="print-page">

        <div class="token">

            <div class="clinic-name">
                @Model.ClinicName
            </div>

            <div class="clinic-subtitle">
                Appointment Token
            </div>

            <div class="divider"></div>

            <!-- TOKEN NUMBER -->
            <div class="token-label">
                TOKEN NO.
            </div>

            <div class="token-number">
                @Model.TokenNumber.ToString("000")
            </div>

            <div class="divider"></div>

            <!-- APPOINTMENT DETAILS -->
            <div class="appointment-details">

                <div class="detail-row">
                    <span class="label">Patient:</span>
                    <span>@Model.PatientName</span>
                </div>

                <div class="detail-row">
                    <span class="label">Doctor:</span>
                    <span>@Model.DoctorName</span>
                </div>

                <div class="detail-row">
                    <span class="label">Department:</span>
                    <span>@Model.DepartmentName</span>
                </div>

                <!-- QUEUE NUMBER AFTER DOCTOR + DEPARTMENT -->
                <div class="detail-row queue-row">
                    <span class="label">Queue No:</span>
                    <span class="queue-number">
                        @Model.QueueNumber.ToString("000")
                    </span>
                </div>

                <div class="detail-row">
                    <span class="label">Date:</span>
                    <span>@Model.AppointmentDate.ToString("dd-MMM-yyyy")</span>
                </div>

                <div class="detail-row">
                    <span class="label">Time:</span>
                    <span>@Model.SlotTime.ToString(@"hh\:mm")</span>
                </div>

            </div>

            <div class="divider"></div>

            <div class="footer">
                Please wait for your turn.
            </div>

        </div>

        <!-- SCREEN-ONLY CONTROLS -->
        <div class="print-controls">

            <button type="button"
                    class="btn-print"
                    onclick="window.print()">
                Print
            </button>

            <button type="button"
                    class="btn-back"
                    onclick="goBack()">
                Back
            </button>

        </div>

    </div>


    <script>

        function goBack() {

            window.location.href =
                '@Url.Action("Index", "AppointmentBooking")';

        }

    </script>

</body>
</html>