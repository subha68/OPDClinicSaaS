@{
Layout = "~/Views/Shared/_Layout.cshtml";
ViewData["Title"] = "Appointment Booking";
}

@model ViewModels.AppointmentBookingVM

<div class="row">
<div class="col-md-4">
    <label>Department</label>

    <select id="departmentId"
            asp-for="DepartmentId"
            asp-items="Model.Departments"
            class="form-select">

        <option value="">Select</option>

    </select>
</div>

<div class="col-md-4">
    <label>Doctor</label>

    <select id="doctorId"
            asp-for="DoctorId"
            class="form-select">

        <option value="">Select</option>

    </select>
</div>

<div class="col-md-4">
    <label>Date</label>

    <input type="date"
           id="appointmentDate"
           asp-for="AppointmentDate"
           class="form-control" />
</div>

</div> 
<hr /> 
<div id="slotContainer" class="slot-container"> 
</div> 
<!-- ============================================================ APPOINTMENT DETAILS MODAL ============================================================ --> 
<div class="modal fade" 
    id="appointmentModal" 
    tabindex="-1">

<div class="modal-dialog">

    <div class="modal-content">

        <div class="modal-header">

            <h5 class="modal-title">
                Appointment Details
            </h5>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
            </button>

        </div>

        <div class="modal-body">

            <input type="hidden"
                   id="modalAppointmentId" />

            <div id="appointmentDetailsSection">

                <div class="mb-2">

                    <strong>Patient:</strong>

                    <span id="modalPatientName"></span>

                </div>

                <div class="mb-2">

                    <strong>Date:</strong>

                    <span id="modalAppointmentDate"></span>

                </div>

                <div class="mb-2">

                    <strong>Time:</strong>

                    <span id="modalSlotTime"></span>

                </div>

                <div class="mb-2">

                    <strong>Status:</strong>

                    <span id="modalStatus"></span>

                </div>

                <div class="mb-2"
                     id="financialStatusRow">

                    <strong>Financial Status:</strong>

                    <span id="modalFinancialStatus"></span>

                </div>

            </div>

            <div id="cancelReasonSection"
                 class="mb-2"
                 style="display:none;">

                <strong>Reason:</strong>

                <textarea id="cancelReason"
                          class="form-control"
                          rows="2"
                          style="max-width:280px;">
                </textarea>

            </div>

            <div id="cancelledAppointmentsContainer"
                 style="display:none;">
            </div>

        </div>

        <div class="modal-footer">

            <button type="button"
                    class="btn btn-primary"
                    id="btnReschedule">

                Reschedule

            </button>

            <button type="button"
                    class="btn btn-danger"
                    id="btnCancel">

                Cancel Appointment

            </button>

            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                Close

            </button>

        </div>

    </div>

</div>

</div> 
<!-- ============================================================ BOOKING MODAL ============================================================ --> 
<div class="modal fade" 
    id="bookingModal" 
    tabindex="-1">

<div class="modal-dialog">

    <div class="modal-content">

        <div class="modal-header">

            <h5 class="modal-title">
                Book Appointment
            </h5>

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
            </button>

        </div>

        <div class="modal-body">

            <input type="hidden"
                   id="bookAppointmentDateTime" />

            @await Html.PartialAsync(
                "_PatientVerticalModal"
            )

            <div class="mb-3">

                <label>Visit Type</label>

                <div>

                    <input type="radio"
                           name="bookVisitType"
                           value="New"
                           checked />

                    New

                    <input type="radio"
                           name="bookVisitType"
                           value="Follow Up"
                           class="ms-3" />

                    Follow Up

                    <input type="radio"
                           name="bookVisitType"
                           value="Report"
                           class="ms-3" />

                    Report

                </div>

            </div>

        </div>

        <div class="modal-footer">

            <button type="button"
                    class="btn btn-success"
                    id="btnConfirmBooking">

                Confirm Booking

            </button>

            <button type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">

                Close

            </button>

        </div>

    </div>

</div>

</div>
@section Scripts {

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js"> </script> 
<script  src="~/js/appointment/appointment-booking.js"> </script>
 
}