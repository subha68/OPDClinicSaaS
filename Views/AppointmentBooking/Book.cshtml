@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model AppointmentCreateVM

<h3>Book Appointment</h3>

<form asp-action="Book" method="post">

    <input type="hidden" asp-for="DoctorId" />
    <input type="hidden"
       id="AppointmentDate"
       name="AppointmentDate"
       value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" />
    <input type="hidden" asp-for="SlotTime" />
    <input type="hidden" asp-for="SlotId" />
    <input type="hidden" asp-for="PatientId" />
    <input type="hidden" asp-for="VisitId" />
    <input type="hidden" asp-for="IsVisitLocked" />

    <div class="mb-3">
        <label>Mobile</label>
        <input asp-for="PatientSearch" class="form-control" />
                <button type="button"
                class="btn btn-primary mt-2"
                onclick="searchPatient()">
            Search Patient
        </button>
    </div>

    <hr />

    <div class="mb-3">
        <label>Patient Name</label>
        <input asp-for="PatientName"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label>Mobile</label>
        <input asp-for="Mobile"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label>Visit Type</label>

        <div>
            <input type="radio"
                asp-for="VisitType"
                value="New"
                id="vtNew"
                disabled="@Model.IsVisitLocked" />
            <label for="vtNew">New</label>

            <input type="radio"
                asp-for="VisitType"
                value="Follow Up"
                id="vtFollow"
                class="ms-3"
                disabled="@Model.IsVisitLocked" />
            <label for="vtFollow">Follow Up</label>

            <input type="radio"
                asp-for="VisitType"
                value="Report"
                id="vtReport"
                class="ms-3"
                disabled="@Model.IsVisitLocked" />
            <label for="vtReport">Report</label>
        </div>
    </div>

    <button type="submit"
            class="btn btn-success">
        Confirm Booking
    </button>

</form>

<script>
    function searchPatient() {

        var mobile = $("#PatientSearch").val();

        $.get('/AppointmentBooking/SearchByMobile?mobile=' + mobile, 
            function (data) {
                if (data) {
                    $("#PatientId").val(data.patientId);
                    $("#PatientName").val(data.name);
                    $("#Mobile").val(data.mobile);

                    checkVisit();
                }
                else {
                    alert("Patient not found");
                    $("#PatientId").val("");
                    $("#PatientName").val("");
                    $("#Mobile").val("");
                }
            });
    };

function checkVisit() {
    var patientId = $("#PatientId").val();
    var date = $("#AppointmentDate").val();

    $.get('/AppointmentBooking/GetVisit?patientId='
            + patientId +
            '&visitDate=' + date,
            function (data) {
                if (data && data.visitId > 0) {
                    $("#VisitId").val(data.visitId);
                    $("input[name='VisitType'][value='" + data.visitType + "']").prop("checked", true);
                    $("input[name='VisitType']").prop("disabled", true);
                    $("#IsVisitLocked").val(true);
                }
                else {
                    $("#VisitId").val(0);
                    $("input[name='VisitType']").prop("disabled", false);
                    $("input[name='VisitType'][value='New']").prop("checked", true);
                    $("#IsVisitLocked").val(false);
                }
            });
    }

</script>