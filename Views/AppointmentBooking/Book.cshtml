@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Book Appointment";
}

@model ViewModels.AppointmentCreateVM

<form asp-action="Book" method="post">
    <input type="hidden" asp-for="DepartmentId" />
    <input type="hidden" asp-for="DoctorId" />
    <input type="hidden"
       id="AppointmentDate"
       name="AppointmentDate"
       value="@Model.AppointmentDate.ToString("yyyy-MM-dd")" />
    <input type="hidden" asp-for="AppointmentDateTime"
                        value="@Model.AppointmentDateTime.ToString("yyyy-MM-ddTHH:mm")" />
    <input type="hidden" asp-for="SlotTime" />
    <input type="hidden" asp-for="PatientId" />
    <input type="hidden" asp-for="VisitId" />
    <input type="hidden" asp-for="IsVisitLocked" />

    <div class="mb-3">
        <button type="button" class="btn btn-primary mt-2" onclick="searchPatient()">
            Search Patient
        </button>
    </div>

    <hr />

    <div class="mb-3">
        <label>Patient Name</label>
        <input asp-for="PatientName"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label>Mobile</label>
        <input asp-for="PatientPhone"
               class="form-control"
               readonly />
    </div>

    <div class="mb-3">
        <label>Visit Type</label>

        <div>
            <input type="radio"
                asp-for="VisitType"
                value="New"
                id="vtNew"
                disabled="@Model.IsVisitLocked" />
            <label for="vtNew">New</label>

            <input type="radio"
                asp-for="VisitType"
                value="Follow Up"
                id="vtFollow"
                class="ms-3"
                disabled="@Model.IsVisitLocked" />
            <label for="vtFollow">Follow Up</label>

            <input type="radio"
                asp-for="VisitType"
                value="Report"
                id="vtReport"
                class="ms-3"
                disabled="@Model.IsVisitLocked" />
            <label for="vtReport">Report</label>
        </div>
    </div>

    <button type="submit"
            class="btn btn-success">
        Confirm Booking
    </button>

</form>

<script>
function searchPatient() {
    var appointmentDateTime = $("#AppointmentDateTime").val();
    var departmentId = $("#DepartmentId").val();
    var doctorId = $("#DoctorId").val();
    console.log(appointmentDateTime);

    window.location =
        '/AppointmentBooking/SearchPatient?' +
        'departmentId=' + departmentId +
        '&doctorId=' + doctorId +
        '&appointmentDateTime=' + encodeURIComponent(appointmentDateTime);
}

function checkVisit() {
    var patientId = $("#PatientId").val();
    var date = $("#AppointmentDate").val();

    $.get('/AppointmentBooking/GetVisit?patientId='
            + patientId +
            '&visitDate=' + date,
            function (data) {
                if (data && data.visitId > 0) {
                    $("#VisitId").val(data.visitId);
                    $("input[name='VisitType'][value='" + data.visitType + "']").prop("checked", true);
                    $("input[name='VisitType']").prop("disabled", true);
                    $("#IsVisitLocked").val(true);
                }
                else {
                    $("#VisitId").val(0);
                    $("input[name='VisitType']").prop("disabled", false);
                    $("input[name='VisitType'][value='New']").prop("checked", true);
                    $("#IsVisitLocked").val(false);
                }
            });
    }

</script>