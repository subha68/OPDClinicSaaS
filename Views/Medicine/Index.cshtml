@model IEnumerable<Models.Medicine>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Medicine Master";

    ViewBag.PageTitle = "Medicine Master";

    ViewBag.Fields = new []
    {
        new { Name="MedicineCode", Label="Code", Type="text", Color="" },
        new { Name="MedicineName", Label="Name", Type="text", Color="" },
        new { Name="GenericName", Label="Generic Name", Type="text", Color="" },
        new { Name="Strength", Label="Strength", Type="text", Color="" },
        new { Name="HSNCode", Label="HSN", Type="text", Color="" },
        new { Name="DosageForm", Label="Dosage", Type="text", Color="" },
        new { Name="UnitOfMeasure", Label="Unit", Type="text", Color="" }
    };

    ViewBag.KeyField = "MedicineId";

    ViewBag.SearchFields = new[]
    {
        "MedicineCode",
        "MedicineName",
        "GenericName",
        "Manufacturer"
    };

    ViewBag.PageSize = 10;

}

@await Html.PartialAsync("_CrudList", Model)
