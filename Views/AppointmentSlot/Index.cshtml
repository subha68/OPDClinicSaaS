@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model IEnumerable<Models.AppointmentSlot>

<h3>Available Appointment Slots</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Start</th>
            <th>End</th>
            <th>Book</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.SlotDate.ToShortDateString()</td>
                <td>@s.StartDateTime</td>
                <td>@s.EndDateTime</td>
                <td>
                    <a asp-controller="Appointment"
                       asp-action="Book"
                       asp-route-slotId="@s.SlotId"
                       class="btn btn-success btn-sm">
                        Book
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>