@model Models.Clinic

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit =
        Model != null &&
        Model.ClinicId > 0;

    ViewBag.PageTitle = isEdit ? "Edit Clinic" : "Create Clinic";

    ViewBag.Fields = new[]
    {
        new { Name="Name", Label="Clinic Name", Type="text", Col="12"},
        new { Name="Address", Label="Address", Type="text", Col="12"},
        new { Name="Phone", Label="Phone", Type="text", Col="4"},
        new { Name="ClinicCode", Label="Clinic Code", Type="text", Col="2"},
        new { Name="LogoPath", Label="Logo Path", Type="text", Col="6"},
    };

    ViewBag.Dropdowns = new Dictionary<string, object>()
    {
    };

    ViewBag.KeyField = "ClinicId";
}

@await Html.PartialAsync("_CrudForm", Model)