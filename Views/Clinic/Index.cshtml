@model IEnumerable<Models.Clinic>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Clinic Management";

    ViewBag.PageTitle = "Clinic Management";

    ViewBag.Fields = new []
    {
        new { Name="ClinicCode", Label="Clinic Code", Type="text", Color=""},
        new { Name="Name", Label="Clinic Name", Type="text", Color="" },
        new { Name="Address", Label="Address", Type="text", Color="" },
        new { Name="Phone", Label="Phone", Type="text", Color="" }
    };


    ViewBag.KeyField = "ClinicId";
}

@await Html.PartialAsync("_CrudList", Model)
