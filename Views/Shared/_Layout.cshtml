@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool isLoginPage = 
        controller == "Account" &&
        action == "Login";

    var pageTitle =
        ViewData["Title"]?.ToString() ?? "ClinicsRUs";
}

<!DOCTYPE html>
<html>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport"
            content="width=device-width, initial-scale=1" />

        <title>@ViewData["Title"] - ClinicsRUs</title>

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet">

        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
            rel="stylesheet" />

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
            rel="stylesheet">

        <link rel="stylesheet"
            href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">

        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

        <link rel="stylesheet"
            href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

        <link href="~/css/app-layout.css" rel="stylesheet" asp-append-version="true" />

        <link href="~/css/crud.css" rel="stylesheet" asp-append-version="true" />

        <link href="~/css/schedule.css" rel="stylesheet" asp-append-version="true" />

        <link href="~/css/appointment.css" rel="stylesheet" asp-append-version="true" />

        <link href="~/css/patient-selection.css" rel="stylesheet" asp-append-version="true" />      

        <link href="~/css/test-result.css" rel="stylesheet" asp-append-version="true" />      

        @RenderSection("Styles", required: false)
    </head>

    <body>

    @if (!isLoginPage)
    {
        <!-- TOP HEADER -->
        <div class="app-shell">

            @{
                var role = HttpContextAccessor.HttpContext.Session.GetString("RoleName");
                var firstName = HttpContextAccessor.HttpContext.Session.GetString("FirstName");
                var lastName = HttpContextAccessor.HttpContext.Session.GetString("LastName");
                var clinicCode = Context.Session.GetString("ClinicCode");
                var clinicName = Context.Session.GetString("ClinicName");
                var clinicLogo = Context.Session.GetString("ClinicLogo");
            }

            <aside class="sidebar">

                <div class="sidebar-scroll-area">

                    <div class="sidebar-header">

                        <div class="sidebar-logo">

                            @if (!string.IsNullOrEmpty(clinicLogo))
                            {
                                <img src="~/images/@clinicLogo"
                                    asp-append-version="true"
                                    alt="@clinicName" />
                            }
                            else
                            {
                                <img src="~/images/default-clinic.png"
                                    asp-append-version="true"
                                    alt="Clinic" />
                            }

                        </div>

                        <div class="sidebar-clinic-name">
                            @clinicName
                        </div>

                        @if (!string.IsNullOrWhiteSpace(clinicCode))
                        {
                            <div class="sidebar-clinic-code">
                                @clinicCode
                            </div>
                        }

                        <div class="sidebar-user-divider"></div>

                        <div class="sidebar-welcome">
                            Welcome
                        </div>

                        <div class="sidebar-user-name">
                            @firstName @lastName
                        </div>

                        <div class="sidebar-user-role">
                            @role
                        </div>

                    </div>

                    <div class="sidebar-menu-container">
                        @await Component.InvokeAsync("NavMenu")
                    </div>

                </div>

                <div class="sidebar-footer">

                    <div class="copyright-text">
                        © @DateTime.Now.Year
                    </div>

                    <div class="company-text">
                        Developed and Supported by
                        <strong>BEC Technologies Pvt Ltd</strong>
                    </div>

                </div>

            </aside>

            <div class="main-area">

                <main class="page-body">
                    
                    <div class="page-title">
                        @pageTitle
                    </div>
                    
                    <div id="appMessage"
                        class="alert d-none"
                        role="alert">
                    </div>

                    @await Html.PartialAsync("_PatientHeader")

                    @RenderBody()

                </main>

            </div>

        </div>

        <!-- Shared Change Password Modal -->
        <partial name="_ChangePasswordModal" />

        <!-- Shared Vitals Modal -->
        <partial name="_VitalModal" /> 

        <!-- Shared Test Results Modal -->
        <partial name="_TestResultModal" />       
    }
    else
    {
        <main class="page-body">

            <!-- Global application message -->
            <div id="appMessage"
                class="alert d-none"
                role="alert">
            </div>

            @RenderBody()

        </main>
    }


    <!-- JavaScript -->

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script src="~/js/crudlist.js" asp-append-version="true"></script>

    <script src="~/js/consult.js" asp-append-version="true"></script>

    <script src="~/js/helper.js" asp-append-version="true"></script>

    <script src="~/js/password-toggle.js" asp-append-version="true"></script>

    <script src="~/js/manage-patient-cache.js" asp-append-version="true"> </script> 

    @if (!isLoginPage)
    {    
        <script src="~/js/change-password.js" asp-append-version="true"></script>
        <script src="~/js/vital.js" asp-append-version="true"></script>
        <script src="~/js/test/test-result.js" asp-append-version="true"></script>
    }

    <script>
    document.addEventListener("DOMContentLoaded", function () {

        const message = '@Html.Raw(TempData["Message"] ?? "")';
        const type = '@Html.Raw(TempData["MessageType"] ?? "")';

        if (message) {

            const alert = $("#appMessage");

            alert
                .removeClass("d-none alert-success alert-danger alert-warning alert-info")
                .addClass(`alert-${type}`)
                .html(message);

            setTimeout(function () {
                alert
                    .fadeOut(500, function () {
                        $(this).addClass("d-none").show();
                    });
            }, 4000);
        }

    });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    </body>
</html>