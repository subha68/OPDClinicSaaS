<!DOCTYPE html>
<html>
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
    <title>OPD Clinic</title>
</head>
<body>

<div>
    @using Microsoft.AspNetCore.Http
    @inject IHttpContextAccessor HttpContextAccessor
    @inject IHttpContextAccessor HttpContextAccessor

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Clinic SaaS</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                @await Component.InvokeAsync("NavMenu")

                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-warning" asp-controller="Account" asp-action="Logout">
                            Logout
                        </a>
                    </li>
                </ul>

            </div>
        </div>
    </nav>
    @{
        var crumbs = BreadcrumbHelper.GetBreadcrumb(ViewContext);
    }

    <nav aria-label="breadcrumb">
        <ol class="breadcrumb m-2">
            @foreach (var c in crumbs)
            {
                <li class="breadcrumb-item">@c</li>
            }
        </ol>
    </nav>
</div>

@RenderBody()

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>