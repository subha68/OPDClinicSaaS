@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    bool isLoginPage =
        controller == "Account" &&
        action == "Login";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8"/>
    <meta name="viewport"
          content="width=device-width, initial-scale=1"/>

    <title>@ViewData["Title"] - ClinicsRUs</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css"
          rel="stylesheet"/>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
          rel="stylesheet"/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link href="~/css/app-layout.css" rel="stylesheet" asp-append-version="true"/>
    <link href="~/css/crud.css" rel="stylesheet" />

    @RenderSection("Styles", required:false)
</head>

<body>

@if (!isLoginPage)
{
    <div class="app-shell">

        <!-- TOP HEADER -->
        <header class="top-header">
            <div class="brand">
                <div class="brand-logo">
                    <i class="fa-solid fa-staff-snake"></i>
                </div>

                <div>
                    <div class="brand-name">
                        Clinics<span>RUs</span>
                    </div>
                    <div class="brand-tagline">
                        Smart Clinics. Better Care.
                    </div>
                </div>
            </div>

            <div>
                <nav class="navbar navbar-expand-lg navbar-custom px-4">
                    <a class="navbar-brand text-white" href="/">ClinicsRUs</a>
                    @await Component.InvokeAsync("NavMenu")
                </nav>
            </div>

            <div class="header-right">
                <div class="org-chip">
                    <i class="fa-solid fa-hospital"></i>
                    @Context.Session.GetString("ClinicCode")
                </div>

                <div class="user-menu dropdown">
                    <button class="btn user-btn dropdown-toggle"
                            data-bs-toggle="dropdown">
                        @{
                            var username = HttpContextAccessor.HttpContext.Session.GetString("Username");
                            var role = HttpContextAccessor.HttpContext.Session.GetString("RoleName");
                            var displayName = HttpContextAccessor.HttpContext.Session.GetString("FirstName") + " " 
                                                    + HttpContextAccessor.HttpContext.Session.GetString("LastName");
                        }

                        Welcome, @displayName
                    </button>

                    <ul class="dropdown-menu dropdown-menu-end">

                        <li class="dropdown-item-text">
                            <strong>User: @username</strong>
                        </li>

                        <li class="dropdown-item-text">
                            Name: @displayName
                        </li>

                        <li class="dropdown-item-text">
                            Role: @role
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <form asp-controller="Account"
                                asp-action="Logout"
                                method="post"
                                style="display:inline;">
                                <button type="submit"
                                        class="dropdown-item">
                                    Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>
        
        <main class="page-body">
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

@await RenderSectionAsync("Scripts", required:false)

</body>
</html>