@model dynamic

<div class="page-shell">
    <div class="glass-card">

        <form method="post">
            @{
                var keyProp = Model?.GetType().GetProperty(ViewBag.KeyField);
                var keyValue = keyProp?.GetValue(Model);
            }

            <input type="hidden"
                name="@ViewBag.KeyField"
                value="@keyValue" />

            <div class="row">
                @foreach (var field in ViewBag.Fields)
                {
                    @if(field.Type == "text")
                    {
                        <div class="col-md-@field.Col mb-4">
                            <label>@field.Label</label>

                            <input name="@field.Name"
                                value="@Model?.GetType().GetProperty(field.Name)?.GetValue(Model)"
                                class="form-control"/>
                        </div>
                    }

                    @if(field.Type == "readonly")
                    {
                        <div class="col-md-@field.Col mb-4">
                            <label>@field.Label</label>
                            <input name="@field.Name"
                                value="@Model?.GetType().GetProperty(field.Name)?.GetValue(Model)"
                                class="form-control"
                                readonly />
                        </div>
                    }

                    @if(field.Type == "hidden")
                    {
                        <input name="@field.Name"
                            id="@field.Name"
                            value="@Model?.GetType().GetProperty(field.Name)?.GetValue(Model)"
                            type="hidden" />
                    }

                    @if (field.Type == "password")
                    {
                        <div class="col-md-@field.Col mb-4">

                            <label class="form-label">
                                @field.Label
                            </label>

                            <div class="input-group">

                                <input type="password"
                                    name="@field.Name"
                                    id="@field.Name"
                                    class="form-control"
                                    placeholder="Enter password"
                                    autocomplete="new-password" />

                                <button type="button"
                                        class="btn btn-outline-secondary password-toggle"
                                        data-target="@field.Name"
                                        tabindex="-1"
                                        title="Show password"
                                        aria-label="Show password">

                                    <i class="fa-solid fa-eye"></i>

                                </button>

                            </div>

                        </div>
                    }

                    @if(field.Type == "dropdown")
                    {
                        <div class="col-md-@field.Col mb-4">
                            <label>@field.Label</label>
                            @Html.DropDownList(
                                field.Name,
                                ViewBag.Dropdowns[field.Name],
                                "-- Select --",
                                new { @class="form-select" })
                        </div>
                    }

                    @if(field.Type == "number")
                    {
                        <div class="col-md-@field.Col mb-4">
                            <label>@field.Label</label>
                            <input name="@field.Name"
                                value="@Model?.GetType().GetProperty(field.Name)?.GetValue(Model)"
                                class="form-control"
                                step="0.01" />
                        </div>

                    }

                    @if(field.Type == "checkbox")
                    {
                        <div class="col-md-@field.Col mb-4">
                            <label>@field.Label</label>
                            @{var isChecked = Convert.ToBoolean(
                                                            Model?.GetType().GetProperty(field.Name)?.GetValue(Model) ?? false
                                                        );}

                            <input type="checkbox"
                                name="@field.Name"
                                value="true"
                                class="form-check-input"
                                checked="@isChecked" />
                        </div>
                    }

                    @if (field.Type == "date")
                    {
                        <div class="col-md-@field.Col mb-4">
                            <label>@field.Label</label>
                            <input type="date"
                                name="@field.Name"
                                value="@((Model?.GetType().GetProperty(field.Name)?.GetValue(Model) is DateTime dt) ? dt.ToString("yyyy-MM-dd") : "")"
                                class="form-control" />
                        </div>
                    }

                    @if (field.Type == "autocomplete")
                    {
                        var textId = field.Name + "_Text";

                        <div class="col-md-@field.Col mb-4">
                            <label>@field.Label</label>

                            <input type="text"
                                id="@textId"
                                class="form-control autocomplete-field"
                                autocomplete="off" />

                            <input type="hidden"
                                name="@field.Name"
                                id="@field.Name"
                                value="@Model?.GetType().GetProperty(field.Name)?.GetValue(Model)" />
                        </div>
                    }

                    @if (field.Type == "file")
                    {
                        var pickerId = field.Name + "_Picker";

                        <div class="col-md-@field.Col mb-4">
                            <label>@field.Label</label>

                            <div class="input-group">
                                <input type="text"
                                    id="@field.Name"
                                    name="@field.Name"
                                    value="@Model?.GetType().GetProperty(field.Name)?.GetValue(Model)"
                                    class="form-control"
                                    readonly />

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        onclick="document.getElementById('@pickerId').click();"
                                        title="Select file">
                                    <i class="bi bi-folder2-open"></i>
                                </button>
                            </div>

                            <input type="file"
                                id="@pickerId"
                                class="d-none"
                                accept="image/*"
                                onchange="setSelectedFileName(this, '@field.Name')" />
                        </div>
                    }
                }
            </div>
            <button class="btn btn-future">
                Save
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary ms-2">
               Cancel
            </a>

        </form>

    </div>
</div>

