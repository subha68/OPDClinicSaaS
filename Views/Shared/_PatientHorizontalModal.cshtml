<!-- Patient Selection Section -->

<div class="patient-selection-context px-3"
     data-patient-selection-context>

    <input type="hidden" data-patient-id />

    <div class="row g-3 align-items-end">

        <!-- Patient Search -->
        <div class="col-md-6">

            <label class="form-label">
                Patient
            </label>

            <input type="text"
                   class="form-control"
                   data-patient-search
                   autocomplete="off" />

        </div>

        <!-- Gender / Age -->
        <div class="col-md-2">

            <label class="form-label">
                Gender / Age
            </label>

            <input type="text"
                   class="form-control"
                   data-patient-gender-age
                   readonly />

        </div>

        <!-- Phone -->
        <div class="col-md-3">

            <label class="form-label">
                Phone
            </label>

            <input type="text"
                   class="form-control"
                   data-patient-phone
                   readonly />

        </div>

        <!-- Error -->
        <div class="col-12">

            <div class="alert alert-danger d-none mb-0"
                 data-patient-error>
            </div>

        </div>

    </div>

</div>
