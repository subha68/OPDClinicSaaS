@model IEnumerable<dynamic>

<div class="page-shell">
    <div class="glass-card">

        <!-- Header -->
        <div class="d-flex justify-content-between mb-3">
            <h2 class="page-title">@ViewBag.PageTitle</h2>

            <div>
                @if (ViewBag.CreateButtonText != null)
                {
                    <a href="@ViewBag.CreateUrl"
                       class="btn btn-future">
                        @ViewBag.CreateButtonText
                    </a>
                }
                else
                {
                    <a asp-action="Create"
                       class="btn btn-future">
                        + Add New
                    </a>
                }
            </div>
        </div>


        <!-- Optional Search Panel -->
        @if (ViewBag.ShowPatientSearch == true)
        {
            <form asp-action="Search" method="get" class="row g-2 mb-4">

                <div class="col-md-4">
                    <input type="text"
                           name="searchText"
                           value="@Context.Request.Query["searchText"]"
                           class="form-control"
                           placeholder="Search by Patient Name / Mobile" />
                </div>

                <div class="col-md-2">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        Search
                    </button>
                </div>

            </form>
        }


        <!-- Grid -->
        <table class="table table-hover table-future">
            <thead>
                <tr>
                    @foreach (var field in ViewBag.Fields)
                    {
                        <th>@field.Label</th>
                    }

                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in Model)
                {
                    var keyValue = row.GetType().GetProperty(ViewBag.KeyField)?.GetValue(row);

                    <tr>
                        @foreach (var field in ViewBag.Fields)
                        {
                            <td>
                                @{
                                    var property = row.GetType().GetProperty(field.Name);
                                    var value = property?.GetValue(row, null);

                                    string colorFn = field.Color ?? "";
                                    string color = "";

                                    if (ViewBag.Functions != null)
                                    {
                                        var funcs = 
                                                                ViewBag.Functions as Dictionary<string, Func<dynamic, string>>;

                                        if (funcs != null && funcs.ContainsKey(colorFn))
                                        {
                                            color = funcs[colorFn](row);
                                        }
                                    }

                                    <span style="color:@color">
                                        @if (field.Type == "date")
                                        {
                                            DateTime dt = (DateTime)value;
                                            @dt.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            @(value ?? "")
                                        }
                                    </span>
                                }                            
                            </td>
                        }

                        <td class="text-center">

                            @if (ViewBag.CustomActions != null)
                            {
                                foreach (var action in ViewBag.CustomActions)
                                {
                                    <a asp-controller="@action.Controller"
                                       asp-action="@action.Action"
                                       asp-route-id="@keyValue"
                                       class="btn btn-sm btn-outline-@action.Type m-1">
                                        @action.Label
                                    </a>
                                }
                            }
                            else
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@keyValue"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@keyValue"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Are you sure?');">
                                    Delete
                                </a>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>