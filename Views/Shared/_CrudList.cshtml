@model IEnumerable<dynamic>

<div class="page-shell crudListContainer">
    <div class="glass-card">

        <!-- Header -->
        <div class="d-flex justify-content-between mb-3">
            <h2 class="page-title">@ViewBag.PageTitle</h2>

            <div class="d-flex align-items-center gap-2">
                @if (ViewBag.SearchFields != null)
                {
                    <input type="text"
                        id="txtSearch"
                        class="form-control"
                        style="width:250px"
                        placeholder="Search..." />
                }

                @if (ViewBag.CustomHeaderActions != null)
                {
                    <div>
                        @foreach (var action in ViewBag.CustomHeaderActions)
                        {
                            <a asp-controller="@action.Controller"
                            asp-action="@action.Action"
                            class="btn btn-sm btn-primary">
                                @action.Label
                            </a>
                        }
                    </div>
                }
                else
                {
                    <a asp-action="Create"
                    class="btn btn-future">
                        + Add New
                    </a>
                }

            </div>
        </div>

        @if (ViewBag.HeaderFields != null)
        {
            <div class="row mb-3">
                @foreach (var field in ViewBag.HeaderFields)
                {
                    <div class="col-md-@field.Col">
                        <strong>@field.Label:</strong> @field.Value 
                    </div>
                }
            </div>
        }

        <!-- Grid -->
        <table id="crudTable"
                data-pagesize="@(ViewBag.PageSize ?? 10)"
                class="table table-hover table-future">
            <thead>
                <tr>
                    @foreach (var field in ViewBag.Fields)
                    {
                        <th>@field.Label</th>
                    }

                    <th class="text-center">Action</th>
                </tr>
            </thead>

            <tbody id="crudBody">
                @foreach (var row in Model)
                {
                    var keyValue = row.GetType().GetProperty(ViewBag.KeyField)?.GetValue(row);

                    string searchText = "";

                    if (ViewBag.SearchFields != null)
                    {
                        foreach (string searchField in ViewBag.SearchFields)
                        {
                            var prop = row.GetType().GetProperty(searchField);

                            if (prop != null)
                            {
                                searchText += " " + Convert.ToString(prop.GetValue(row));
                            }
                        }
                    }

                    <tr data-search="@searchText.ToLower()">
                        @foreach (var field in ViewBag.Fields)
                        {
                            <td>
                                @{
                                    var property = row.GetType().GetProperty(field.Name);
                                    var value = property?.GetValue(row, null);

                                    string colorFn = field.Color ?? "";
                                    string color = "";

                                    if (ViewBag.ColorFunctions != null)
                                    {
                                        var funcs = 
                                                                ViewBag.ColorFunctions as Dictionary<string, Func<dynamic, string>>;

                                        if (funcs != null && funcs.ContainsKey(colorFn))
                                        {
                                            color = funcs[colorFn](row);
                                        }
                                    }

                                    <span style="color:@color">
                                        @if (field.Type == "date" && value != null)
                                        {
                                            DateTime dt = (DateTime)value;
                                            @dt.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            @(value ?? "")
                                        }
                                    </span>
                                }                            
                            </td>
                        }

                        <td class="text-center">

                            @if (ViewBag.CustomLineActions != null)
                            {
                                foreach (var action in ViewBag.CustomLineActions)
                                {
                                    if (ViewBag.CheckFunctions != null && !string.IsNullOrWhiteSpace(action.condition))
                                    {
                                        var checkFuncs = 
                                                                ViewBag.CheckFunctions as Dictionary<string, Func<dynamic, bool>>;

                                        if (checkFuncs != null && checkFuncs.ContainsKey(action.condition))
                                        {
                                            bool canShow = checkFuncs[action.condition](row);

                                            if (!canShow)
                                            {
                                                continue;
                                            }
                                        }
                                    }
                                    <a asp-controller="@action.Controller"
                                       asp-action="@action.Action"
                                       asp-route-id="@keyValue"
                                       class="btn btn-sm btn-outline-@action.Type m-1">
                                        @action.Label
                                    </a>
                                }
                            }
                            else
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@keyValue"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@keyValue"
                                   class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Are you sure?');">
                                    Delete
                                </a>
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between mt-3">

            <div id="recordInfo"></div>

            <nav>
                <ul class="pagination pagination-sm mb-0"
                    id="pager">
                </ul>
            </nav>
        </div>

    </div>
</div>

