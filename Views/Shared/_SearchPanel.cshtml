@model SearchPanelVM

<form method="get"
      asp-action="@Model.SearchAction">

    <div class="row mb-4">

        <div class="col-md-6">

            <input type="text"
                   name="searchText"
                   value="@Model.SearchText"
                   class="form-control"
                   placeholder="@Model.Placeholder"/>

        </div>

        <div class="col-md-2">

            <button type="submit"
                    class="btn btn-primary w-100">

                Search

            </button>

        </div>

        <div class="col-md-4 text-end">

            <a asp-action="@Model.CreateAction"
               class="btn btn-outline-primary">

                <i class="fa fa-plus"></i>

                @Model.CreateButtonText

            </a>

        </div>

    </div>

</form>