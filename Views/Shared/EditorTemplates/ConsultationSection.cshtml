@model Models.ConsultationSection

<div class="card consultation-section">

    <input asp-for="SectionId" type="hidden" />
    <input asp-for="ConsultationId" type="hidden" />
    <input asp-for="SectionName" type="hidden" />
    <input asp-for="IsVisible" type="hidden" />
    <input asp-for="Multiline" type="hidden" />
    <input asp-for="IsPharmacologyAdvice" type="hidden" />
    <input asp-for="DisplayOrder" type="hidden" />    

    <div class="card-header bg-light">
        <h5 class="mb-0">@Model.SectionName</h5>
    </div>

    <div class="card-body">

        @if (Model.IsMultiline)
        {
            <partial name="_MultilineSection" model="Model" />
        }
        else if (Model.Rows.Any())
        {
            @Html.EditorFor(m => m.Rows)
        }

    </div>

</div>
