@model Models.ConsultationField

<div class="@Model.ColumnClass">

    <div class="consultation-field @Model.LayoutClass">

        @if (Model.IsOptionGroup)
        {
            <div class="field-row">

                <div class="field-label">

                    <label class="form-label mb-0">

                        @Model.FieldLabel

                        @if (Model.IsMandatory)
                        {
                            <span class="text-danger">*</span>
                        }

                    </label>

                </div>

                <div class="field-editor">

                    <partial name="_FieldRenderer" model="Model" />

                </div>

            </div>
        }
        else if (Model.IsFullWidth)
        {
            <label class="form-label">

                @Model.FieldLabel

            </label>

            <div class="field-editor">

                <partial name="_FieldRenderer" model="Model" />

            </div>
        }
        else
        {
            <div class="field-row">
                @if (!Model.HideLabel)
                {
                    <div class="field-label">
                        <label class="form-label mb-0">

                            @Model.FieldLabel

                            @if (Model.IsMandatory)
                            {
                                <span class="text-danger">*</span>
                            }

                        </label>
                    </div>
                }
                
                <div class="field-editor">

                    <partial name="_FieldRenderer" model="Model" />

                </div>

            </div>
        }

    </div>

</div>