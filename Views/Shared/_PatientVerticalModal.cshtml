<div data-patient-selection-context>

    <input type="hidden"
           data-patient-id />

    <div class="mb-3">
        <label class="form-label">
            Patient
        </label>

        <input type="text"
               class="form-control"
               data-patient-search
               autocomplete="off" />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Gender / Age
        </label>

        <input type="text"
               class="form-control"
               data-patient-gender-age
               readonly />
    </div>

    <div class="mb-3">
        <label class="form-label">
            Phone
        </label>

        <input type="text"
               class="form-control"
               data-patient-phone
               readonly />
    </div>

    <div class="alert alert-danger d-none"
         data-patient-error>
    </div>

</div>
