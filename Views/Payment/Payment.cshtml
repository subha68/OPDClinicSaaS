@model ViewModels.PaymentCreateVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Payment";
}

<h3>Receive Payment</h3>

@await Html.PartialAsync("_Breadcrumb",
    new List<ViewModels.BreadcrumbItemVM>
    {
        new ViewModels.BreadcrumbItemVM
        {
            Text = "Patients",
            Controller = "Patient",
            Action = "Index"
        },

        new ViewModels.BreadcrumbItemVM
        {
            Text = "Bills",
            Controller = "Billing",
            Action = "SearchByPatientId",
            PatientId = Model.Bill.PatientId
        },

        new ViewModels.BreadcrumbItemVM
        {
            Text = "Payments"
        }
    })

<hr />

<div class="row mb-3">
    <div class="col-md-2"><b>Bill No</b><br />@Model.Bill.BillId</div>
    <div class="col-md-2"><b>Bill</b><br />@Model.Bill.NetAmount</div>
    <div class="col-md-2"><b>Paid</b><br />@Model.Bill.TotalPaidAmount</div>
    <div class="col-md-2"><b>Balance</b><br />@Model.Bill.BalanceAmount</div>
    <div class="col-md-2"><b>Status</b><br />@Model.Bill.PaymentStatus</div>
</div>

<hr />

@await Html.PartialAsync("_BackButton", new ViewModels.BackButtonVM
    {
        Controller = "Billing",
        Action = "SearchByPatient",
        PatientId = @Model.Bill.PatientId,
        Text = "Back to Bills"
    })

@if(Model.Bill.BalanceAmount > 0)
{
    <form method="post">

        <input type="hidden" name="Payment.BillId" value="@Model.Bill.BillId" />
        <input type="hidden" name="Payment.PatientId" value="@Model.Bill.PatientId" />

        <div class="mb-3">
            <label class="form-label">Payment Type</label>

            <div>
                <input type="radio" name="PaymentType" id="fullPayment" value="Full" checked />
                <label for="fullPayment">Full Payment</label>

                &nbsp;&nbsp;

                <input type="radio" name="PaymentType" id="partialPayment" value="Partial" />
                <label for="partialPayment">Partial Payment</label>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label>Date</label>

                <input asp-for="Payment.PaymentDate"
                    type="date"
                    class="form-control" />
            </div>

            <div class="col-md-4 mb-3">
                <label>Amount</label>

                <input type="number"
                    step="0.01"
                    id="paymentAmount"
                    name="Payment.Amount"
                    max="@Model.Bill.BalanceAmount"
                    value="@Model.Bill.BalanceAmount"
                    class="form-control" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label>Mode</label>

                <select name="Payment.Mode"
                        class="form-control">
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="UPI">UPI</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                </select>
            </div>

            <div class="col-md-8 mb-3">
                <label>Reference No</label>

                <input type="text"
                    name="Payment.ReferenceNo"
                    class="form-control" />
            </div>
        </div>

        <button type="submit"
                class="btn btn-success">
            Save Payment
        </button>
    </form>

}

<hr />

<h4>Payment History</h4>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Date</th>
            <th>Amount</th>
            <th>Mode</th>
            <th>Reference</th>
        </tr>
    </thead>

    <tbody>

        @foreach(var p in Model.Bill.Payments)
        {
            <tr>
                <td>
                    @p.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")
                </td>

                <td>
                    @p.Amount
                </td>

                <td>
                    @p.Mode
                </td>

                <td>
                    @p.ReferenceNo
                </td>
            </tr>
        }

    </tbody>
</table>

<script>
document.addEventListener("DOMContentLoaded", function () {

    const balance = @Model.Bill.BalanceAmount;
    const amountBox = document.getElementById("paymentAmount");

    document.getElementById("fullPayment")
        .addEventListener("change", function () {

            amountBox.value = balance;
            amountBox.readOnly = true;
        });

    document.getElementById("partialPayment")
        .addEventListener("change", function () {

            amountBox.readOnly = false;
        });

    amountBox.readOnly = true;
});
</script>