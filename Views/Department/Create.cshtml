@model Models.Department

@using Models

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit =
        Model != null &&
        Model.DepartmentId > 0;

    ViewData["Title"] = isEdit ? "Edit Department" : "Create Department";

    ViewBag.Fields = new List<CrudField>
    {
        new CrudField
        { Name = "DepartmentCode", Label = "Department Code", Type = "related-dropdown-input", Col = "3",
            RelatedInputLabel = "Enter a new department code",
            RelatedInputPlaceholder = "Enter unique code",
            RelatedInputTriggerValue = "__OTHER__",
            RelatedInputTriggerLabel = "Other",
            RelatedInputRequired = true
        },
        new CrudField { Name="Name", Label="Name", Type="text", Col="4"},
        new CrudField { Name="Description", Label="Description", Type="text", Col="5"},
        new CrudField { Name="ClinicName", Label="Clinic", Type="readonly", Col="6"},
        new CrudField { Name="PrescriptionTemplateName", Label="Prescription Template", Type="readonly", Col="6"},
    };

    ViewBag.KeyField = "DepartmentId";
}

@await Html.PartialAsync("_CrudForm", Model)

@section Scripts {
    <script src="~/js/shared/crud-form.js" asp-append-version="true"></script>
    <script src="~/js/department/department.js" asp-append-version="true"></script>
}
