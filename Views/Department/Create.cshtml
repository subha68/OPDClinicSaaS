@model Models.Department

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit =
        Model != null &&
        Model.DepartmentId > 0;

    ViewBag.PageTitle = isEdit ? "Edit Department" : "Create Department";

    ViewBag.Fields = new[]
    {
        new { Name="Name", Label="Name", Type="text", Col="6"},
        new { Name="Description", Label="Description", Type="text", Col="6"},
        new { Name="ClinicName", Label="Clinic", Type="readonly", Col="6"}
    };

    ViewBag.Dropdowns = new Dictionary<string, object>()
    {
    };

    ViewBag.KeyField = "DepartmentId";
}

@await Html.PartialAsync("_CrudForm", Model)