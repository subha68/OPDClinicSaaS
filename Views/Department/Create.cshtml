@model Models.Department

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit =
        Model != null &&
        Model.DepartmentId > 0;

    ViewData["Title"] = isEdit ? "Edit Department" : "Create Department";

    ViewBag.Fields = new[]
    {
        new { Name="DepartmentCode", Label="Department Code", Type="text", Col="3"},
        new { Name="Name", Label="Name", Type="text", Col="4"},
        new { Name="Description", Label="Description", Type="text", Col="5"},
        new { Name="ClinicName", Label="Clinic", Type="readonly", Col="6"},
        new { Name="PrescriptionTemplateName", Label="Prescription Template", Type="readonly", Col="6"},
    };

    ViewBag.Dropdowns = new Dictionary<string, object>()
    {
    };

    ViewBag.KeyField = "DepartmentId";
}

@await Html.PartialAsync("_CrudForm", Model)
