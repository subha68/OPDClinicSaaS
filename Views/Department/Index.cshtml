@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model List<ViewModels.DepartmentVM>

<h2>Departments</h2>

<a href="/Department/Create" class="btn btn-primary">Add Department</a>

<table border="1">
    <tr>
        <th>Clinic ID</th>
        <th>Name</th>
        <th>Description</th>
    </tr>

@foreach (var c in Model)
{
    <tr>
        <td>@c.ClinicId</td>
        <td>@c.Name</td>
        <td>@c.Description</td>
    </tr>
}
</table>
