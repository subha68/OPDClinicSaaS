@model IEnumerable<Models.Department>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Department Management";

    ViewBag.PageTitle = "Department Management";

    ViewBag.Columns = new[] { "Name", "Description", "Clinic" };
    ViewBag.Properties = new[] { "Name", "Description", "ClinicName" };

    ViewBag.KeyField = "DepartmentId";
}

@await Html.PartialAsync("_CrudList", Model)