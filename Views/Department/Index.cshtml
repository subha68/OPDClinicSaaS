@model IEnumerable<Models.Department>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Department Management";

    ViewBag.PageTitle = "Department Management";

    ViewBag.Fields = new []
    {
        new { Name="Name", Label="Department Name", Type="text", Color="" },
        new { Name="Description", Label="Description", Type="text", Color="" },
        new { Name="ClinicName", Label="Clinic", Type="text", Color="" }
    };

    ViewBag.KeyField = "DepartmentId";
}

@await Html.PartialAsync("_CrudList", Model)