@model IEnumerable<Models.User>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "User Management";

    ViewBag.PageTitle = "User Management";

    ViewBag.Columns = new[] { "First Name", "Last Name", "Email", "Phone", "User Name", "Role", "Clinic" };
    ViewBag.Properties = new[] { "FirstName", "LastName", "Email", "Phone", "Username", "RoleName", "ClinicName" };

    ViewBag.KeyField = "UserId";
}

@await Html.PartialAsync("_CrudList", Model)