@model IEnumerable<Models.User>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "User Management";

    ViewBag.PageTitle = "User Management";

    ViewBag.Fields = new []
    {
        new { Name="FirstName", Label="First Name", Type="text", Color="" },
        new { Name="LastName", Label="Last Name", Type="text", Color="" },
        new { Name="Email", Label="Email", Type="text", Color="" },
        new { Name="Phone", Label="Phone", Type="text", Color="" },
        new { Name="Username", Label="User Name", Type="text", Color="" },
        new { Name="RoleName", Label="Role", Type="text", Color="" },
        new { Name="ClinicName", Label="Clinic", Type="text", Color="" }
    };

    ViewBag.KeyField = "UserId";
}

@await Html.PartialAsync("_CrudList", Model)