@model Models.User

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isEdit =
        Model != null &&
        Model.UserId > 0;

    ViewBag.PageTitle = isEdit ? "Edit User" : "Create User";

    ViewBag.Fields = new[]
    {
        new { Name="FirstName", Label="First Name", Type="text", Col="6"},
        new { Name="LastName", Label="Last Name", Type="text", Col="6"},
        new { Name="Email", Label="Email", Type="text", Col="6"},
        new { Name="Phone", Label="Phone", Type="text", Col="6"},
        new { Name="Username", Label="User Name", Type="text", Col="6"},
        new { Name="PasswordHash", Label="Password", Type="password", Col="6"},
        new { Name="RoleId", Label="Role", Type="dropdown", Col="6"},
        new { Name="ClinicId", Label="Clinic", Type="dropdown", Col="6"}
    };

    ViewBag.Dropdowns = new Dictionary<string, object>()
    {
        { "RoleId", ViewBag.Roles },
        { "ClinicId", ViewBag.Clinics }
    };

    ViewBag.KeyField = "UserId";
}

@await Html.PartialAsync("_CrudForm", Model)