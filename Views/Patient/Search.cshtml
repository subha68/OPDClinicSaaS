@model ViewModels.PatientSearchVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = "Patient Search";
}

<h3>Patient Search</h3>

<form method="post">
    <div class="row mb-3">
        <div class="col-md-2">
            <input asp-for="PatientId"
                   class="form-control"
                   placeholder="Patient ID" />
        </div>

        <div class="col-md-3">
            <input asp-for="Phone"
                   class="form-control"
                   placeholder="Phone" />
        </div>

        <div class="col-md-3">
            <input asp-for="Name"
                   class="form-control"
                   placeholder="Name" />
        </div>

        <div class="col-md-2">
            <button class="btn btn-primary w-100">
                Search
            </button>
        </div>
    </div>
</form>

@if (Model.Results.Any())
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>DOB</th>
                <th>Gender</th>
                <th>Phone</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        @foreach (var p in Model.Results)
        {
            <tr>
                <td>@p.PatientId</td>
                <td>@p.FirstName @p.LastName</td>
                <td>@p.DOB</td>
                <td>@p.Gender</td>
                <td>@p.Phone</td>
                <td>
                    <a asp-controller="Patient"
                    asp-action="History"
                    asp-route-patientId="@p.PatientId"
                    class="btn btn-primary btn-sm">
                        History
                    </a>                
                </td>
            </tr>
        }
        </tbody>
    </table>
}