@model ViewModels.PatientSearchVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Patient Search";
}

<h3>Patient Search</h3>

<form method="post">

    <input type="hidden" asp-for="ReturnTo" />
    <input type="hidden" asp-for="DepartmentId" />
    <input type="hidden" asp-for="DoctorId" />
    <input type="hidden" asp-for="AppointmentDate"
                        value="@Model.AppointmentDate?.ToString("yyyy-MM-dd")" />
    <input type="hidden" asp-for="SlotTime" />
    <input type="hidden" asp-for="AppointmentDateTime"
                        value="@Model.AppointmentDateTime?.ToString("yyyy-MM-ddTHH:mm")" />

    <div class="row mb-3">

        <div class="col-md-6">
            <input asp-for="SearchString"
                   class="form-control"
                   placeholder="Patient ID / Phone / Name" />
        </div>

        <div class="col-md-2">
            <button class="btn btn-primary">
                Search
            </button>
        </div>

    </div>

</form>

@if (Model.Results.Any())
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>DOB</th>
                <th>Gender</th>
                <th>Phone</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
        @foreach (var p in Model.Results)
        {
            <tr>
                <td>@p.PatientId</td>
                <td>@p.FirstName @p.LastName</td>
                <td>@p.DOB</td>
                <td>@p.Gender</td>
                <td>@p.Phone</td>
                <td>
                    <a asp-action="SelectPatient"
                    asp-route-patientId="@p.PatientId"
                    asp-route-returnTo="@Model.ReturnTo"
                    asp-route-departmentId="@Model.DepartmentId"
                    asp-route-doctorId="@Model.DoctorId"
                    asp-route-appointmentDateTime="@Model.AppointmentDateTime?.ToString("yyyy-MM-ddTHH:mm")"
                    class="btn btn-primary btn-sm">
                        Select
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}