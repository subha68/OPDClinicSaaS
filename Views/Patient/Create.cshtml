@model Models.Patient

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewData["Title"] = "Patient Registration";

    bool isEdit = Model != null && Model.PatientId > 0;

    ViewBag.PageTitle = isEdit ? "Edit Patient" : "Create Patient";

}

<form asp-action=@(isEdit ? "Edit" : "Create")>

<div class="page-card">

    <div class="page-card-header">

        <h4 class="page-card-title">
            Patient Registration
        </h4>

    </div>

    <div class="page-card-body">

        <!-- BASIC DETAILS -->

        <h5 class="mb-3">
            Basic Details
        </h5>

        <div class="row g-3">
            <input asp-for="PatientId"
                       class="form-control" hidden/>

            <div class="col-md-1">
                <label>Title</label>
                <select asp-for="Title"
                        class="form-select">

                    <option>Mr</option>
                    <option>Mrs</option>
                    <option>Miss</option>

                </select>
            </div>

            <div class="col-md-3">
                <label>First Name</label>
                <input asp-for="FirstName"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label>Last Name</label>
                <input asp-for="LastName"
                       class="form-control" />
            </div>

            <div class="col-md-1">
                <label>Gender</label>
                <select asp-for="Gender"
                        class="form-select">

                    <option>Male</option>
                    <option>Female</option>

                </select>
            </div>

            <div class="col-md-2">
                <label>DOB</label>
                <input asp-for="DOB"
                       type="date"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <label>Mobile Number</label>
                <input asp-for="Phone"
                       class="form-control" />
            </div>

        </div>

        <hr />

        <!-- ADDRESS -->

        <h5 class="mb-3">
            Address
        </h5>

        <div class="row g-3">

            <div class="col-md-6">
                <label>Address Line 1</label>
                <input asp-for="Address1"
                       class="form-control" />
            </div>

            <div class="col-md-6">
                <label>Address Line 2</label>
                <input asp-for="Address2"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label>City</label>
                <input asp-for="City"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label>State</label>
                <input asp-for="State"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label>Pin Code</label>
                <input asp-for="PinCode"
                       class="form-control" />
            </div>

        </div>

        <hr />

        <!-- IDENTIFICATION -->

        <h5 class="mb-3">
            Identification
        </h5>

        <div class="row g-3">

            <div class="col-md-3">

                <label>ID Type</label>

                <select asp-for="IdType"
                        class="form-select">

                    <option>Aadhaar</option>
                    <option>PAN</option>
                    <option>Passport</option>

                </select>

            </div>

            <div class="col-md-4">
                <label>ID Number</label>
                <input asp-for="IdNumber"
                       class="form-control" />
            </div>

            <div class="col-md-5">

                <label>Upload ID Proof</label>

                <input type="file"
                       class="form-control" />

            </div>

        </div>

        <hr />

        <!-- EMERGENCY CONTACT -->

        <h5 class="mb-3">
            Emergency Contact
        </h5>

        <div class="row g-3">

            <div class="col-md-4">
                <label>Name</label>
                <input asp-for="EmergencyContactName"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <label>Relationship</label>
                <input asp-for="EmergencyRelationship"
                       class="form-control" />
            </div>

            <div class="col-md-4">
                <label>Mobile Number</label>
                <input asp-for="EmergencyPhone"
                       class="form-control" />
            </div>

        </div>

    </div>

    <div class="card-footer bg-white">

        <div class="d-flex justify-content-end gap-2">

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

            <button type="submit"
                    class="btn btn-primary">

                Save & Continue

            </button>

        </div>

    </div>

</div>

</form>