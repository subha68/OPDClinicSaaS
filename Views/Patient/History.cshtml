@model ViewModels.PatientHistoryVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Patient History";
}

<div class="card mb-3">
    <div class="card-body">

        <h4>
            @Model.FirstName @Model.LastName
        </h4>

        <div class="row">

            <div class="col-md-2">
                <strong>Patient Id</strong><br />
                @Model.PatientId
            </div>

            <div class="col-md-2">
                <strong>Gender</strong><br />
                @Model.Gender
            </div>

            <div class="col-md-2">
                <strong>Age</strong><br />
                @Model.Age
            </div>

            <div class="col-md-3">
                <strong>Phone</strong><br />
                @Model.Phone
            </div>

        </div>

    </div>
</div>

<div class="accordion" id="visitAccordion">

    @foreach (var visit in Model.Visits)
    {
        <div class="accordion-item">

            <h2 class="accordion-header">

                <button class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#visit_@visit.VisitId">

                    Visit : @visit.VisitDate.ToString("dd/MM/yyyy")
                    (@visit.VisitType)
                </button>

            </h2>

            <div id="visit_@visit.VisitId"
                 class="accordion-collapse collapse"
                 data-bs-parent="#visitAccordion">

                <div class="accordion-body">

                    <h5>Appointments</h5>

                    @if (visit.Appointments.Any())
                    {
                        <table class="table table-bordered table-sm">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Doctor</th>
                                    <th>Time</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var appt in visit.Appointments)
                                {
                                    <tr>
                                        <td>@appt.AppointmentDate.ToString("dd/MM/yyyy")</td>
                                        <td>@appt.DoctorName</td>
                                        <td>@appt.SlotTime</td>
                                        <td>@appt.Status</td>
                                        <td>
                                            @if (appt.Status == "Completed")
                                            {
                                                <a asp-controller="Consultation"
                                                    asp-action="Preview"
                                                    asp-route-appointmentId="@appt.AppointmentId"
                                                    target="_blank"
                                                    class="btn btn-sm btn-info">
                                                    View Prescription
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No appointments found.</p>
                    }

                    <hr />

                    <h5>Bills</h5>

                    @if (visit.Bills.Any())
                    {
                        <table class="table table-bordered table-sm">

                            <thead>
                                <tr>
                                    <th>Bill Id</th>
                                    <th>Date</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var bill in visit.Bills)
                                {
                                    <tr>
                                        <td>@bill.BillId</td>
                                        <td>@bill.BillDate.ToString("dd/MM/yyyy")</td>
                                        <td>@bill.GrossAmount</td>
                                        <td>
                                            @(bill.BalanceAmount == 0
                                                ? "Paid"
                                                : "Pending")
                                        </td>
                                        <td>
                                            <a asp-controller="Billing"
                                                asp-action="Print"
                                                asp-route-id="@bill.BillId"
                                                target="_blank"
                                                class="btn btn-sm btn-info">
                                                View Bill
                                            </a>
                                        </td>
                                    </tr>
                                }

                            </tbody>

                        </table>
                    }
                    else
                    {
                        <p>No bills found.</p>
                    }

                </div>

            </div>

        </div>
    }

</div>

@if (Model.HasMoreVisits)
{
    <div class="text-center mt-3">

        <a asp-action="History"
           asp-route-id="@Model.PatientId"
           asp-route-page="@(Model.CurrentPage + 1)"
           class="btn btn-outline-primary">

            More Visits

        </a>

    </div>
}