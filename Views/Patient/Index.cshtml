@model ViewModels.PatientSearchVM

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Patient Search";

    var hasSearch =
        !string.IsNullOrWhiteSpace(Model.SearchString);

    var hasResults =
        Model.Results != null && Model.Results.Any();
}

<div class="page-card">

    <div class="page-card-body">

        <!-- ===================================================== -->
        <!-- SEARCH HEADER                                         -->
        <!-- ===================================================== -->

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h4 class="mb-1">
                    Patient Search
                </h4>

                <div class="text-muted small">
                    Search by Patient ID, mobile number or name
                </div>
            </div>

            <div>
                <a asp-action="Create"
                   asp-route-searchString="@Model.SearchString"
                   class="btn btn-primary">

                    <i class="fa fa-plus me-1"></i>
                    New Patient Registration

                </a>
            </div>

        </div>


        <!-- ===================================================== -->
        <!-- SEARCH FORM                                            -->
        <!-- ===================================================== -->

        <form asp-action="Index"
              method="get">

            <div class="row g-2 mb-4">

                <div class="col-md-8">

                    <label asp-for="SearchString"
                           class="form-label">

                        Search Patient

                    </label>

                    <input asp-for="SearchString"
                           class="form-control"
                           autocomplete="off"
                           placeholder="Patient ID / Mobile Number / Name" />

                </div>

                <div class="col-md-2 align-self-end">

                    <button type="submit"
                            class="btn btn-primary w-100">

                        <i class="fa fa-search me-1"></i>
                        Search

                    </button>

                </div>

                @if (hasSearch)
                {
                    <div class="col-md-2 align-self-end">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100">

                            <i class="fa fa-times me-1"></i>
                            Clear

                        </a>

                    </div>
                }

            </div>

        </form>


        <!-- ===================================================== -->
        <!-- INITIAL STATE                                         -->
        <!-- ===================================================== -->

        @if (!hasSearch)
        {
            <div class="text-center py-5">

                <i class="fa fa-search fa-2x text-muted mb-3"></i>

                <h5>
                    Search for a patient
                </h5>

                <p class="text-muted mb-0">
                    Enter a Patient ID, mobile number or patient name
                    to find a patient.
                </p>

            </div>
        }


        <!-- ===================================================== -->
        <!-- RESULTS                                               -->
        <!-- ===================================================== -->

        @if (hasSearch && hasResults)
        {
            <div class="d-flex justify-content-between align-items-center mb-2">

                <h6 class="mb-0">
                    Matching Patients
                </h6>

                <span class="text-muted small">
                    Showing @Model.Results.Count match@(Model.Results.Count == 1 ? "" : "es")
                </span>

            </div>


            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>

                        <tr>

                            <th>
                                Patient ID
                            </th>

                            <th>
                                Name
                            </th>

                            <th>
                                Mobile
                            </th>

                            <th>
                                Age / Gender
                            </th>

                            <th>
                                Last Visit
                            </th>

                            <th class="text-end">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                    @foreach (var p in Model.Results)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @p.PatientId
                                </strong>
                            </td>

                            <td>
                                @p.FirstName @p.LastName
                            </td>

                            <td>
                                @p.Phone
                            </td>

                            <td>
                                @p.Age / @p.Gender
                            </td>

                            <td>
                                @(p.LastVisitDate?.ToString("dd MMM yyyy") ?? "—")
                            </td>

                            <td class="text-end">

                                <a asp-action="History"
                                   asp-route-id="@p.PatientId"
                                   class="btn btn-sm btn-outline-info me-1">

                                    <i class="fa fa-history me-1"></i>
                                    History

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@p.PatientId"
                                   class="btn btn-sm btn-outline-primary">

                                    <i class="fa fa-edit me-1"></i>
                                    Edit

                                </a>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }


        <!-- ===================================================== -->
        <!-- NO RESULTS                                            -->
        <!-- ===================================================== -->

        @if (hasSearch && !hasResults)
        {
            <div class="text-center py-5">

                <div class="mb-3">

                    <i class="fa fa-user-slash fa-2x text-muted"></i>

                </div>

                <h5>
                    No patient found
                </h5>

                <p class="text-muted mb-4">

                    No patient matched
                    <strong>
                        "@Model.SearchString"
                    </strong>.

                </p>

                <a asp-action="Create"
                   asp-route-searchString="@Model.SearchString"
                   class="btn btn-primary">

                    <i class="fa fa-user-plus me-1"></i>
                    Register New Patient

                </a>

            </div>
        }

    </div>

</div>