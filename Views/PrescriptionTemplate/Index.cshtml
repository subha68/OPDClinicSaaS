@model Models.PrescriptionTemplate

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles
{
    <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />

    <link href="~/css/prescriptiontemplate.css" rel="stylesheet" />
}

<div class="row mb-3">

    <div class="col-md-4">

        <label>Department</label>

        <select id="DepartmentId"
                class="form-control"
                asp-items="ViewBag.Departments">

            <option value="">-- Select Department --</option>

        </select>

    </div>

    <div class="col-md-4">
        <label>Doctor</label>
        <select id="DoctorId"
                class="form-control">
            <option value="">-- Select Doctor --</option>
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button id="btnShowTemplate" class="btn btn-primary w-100">
            Show Template
        </button>
    </div>

    <div class="col-md-2 d-flex justify-content-end align-items-center">

        <div class="form-check form-switch d-flex align-items-center mb-0">

            <input class="form-check-input showInactiveSwitch"
                   type="checkbox"
                   id="showInactive">

            <label class="form-check-label showInactiveLabel"
                   for="showInactive">
                Show Inactive
            </label>

        </div>

    </div>

</div>

<div id="designerContainer">

    @if (Model != null)
    {
        <input type="hidden" id="TemplateId" value="@Model.TemplateId" />
        @await Html.PartialAsync("_TemplateDesigner", Model)
    }
    else
    {
        @await Html.PartialAsync("_NoTemplateFound")
    }

</div>

@section Scripts
{
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

<script src="~/js/template-core.js"></script>
<script src="~/js/template-runtime.js"></script>
<script src="~/js/template-event.js"></script>
<script src="~/js/template-lifecycle.js"></script>

<script>

let isSavingSectionOrder = false;
let isSavingFieldOrder = false;
let isSavingOptionOrder = false;

$(function () {

    initializeDesignerCore();

    $("#showInactive").change(function () {
        applyInactiveFilter();
    });

});

$("#btnShowTemplate").click(function () {

    let departmentId = $("#DepartmentId").val();
    let doctorId = $("#DoctorId").val();

    let url = "";
    let data = {};

    // PRIORITY 1: Doctor
    if (doctorId) {

        url = "/PrescriptionTemplate/GetByDoctor";
        data = { doctorId: doctorId };

    }
    // PRIORITY 2: Department
    else if (departmentId) {

        url = "/PrescriptionTemplate/GetByDepartment";
        data = { departmentId: departmentId };

    }
    // PRIORITY 3: Default clinic template
    else {

        url = "/PrescriptionTemplate/GetByClinic";
        data = { clinicId: $("#ClinicId").val() }; // or hidden field
    }

    $.get(url, data, function (html) {
        $("#designerContainer").html(html);

        // Only initialize the designer when a template was returned
        if ($("#TemplateId").length) {
            initializeDesignerRuntime();
            applyInactiveFilter();
        }
    });

});

</script>
}