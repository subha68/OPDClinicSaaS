@model Models.PrescriptionTemplateSection

@{  
    var fieldNames = Model.Fields
        .OrderBy(x => x.DisplayOrder)
        .Select(x => x.FieldLabel)
        .Take(5);

    var preview = string.Join(", ", fieldNames);

    if (Model.Fields.Count > 5)
    {
        preview += "...";
    }
}

<div class="section-wrapper"
    data-section-id="@Model.SectionId">

    <div class="section-card @(Model.IsActive ? "" : "inactive")">

        <div class="section-header">

            <div class="section-drag drag-handle">
                <i class="bi bi-grip-vertical"></i>
            </div>

            <button class="expand-section btn btn-link p-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#section_@Model.SectionId">

                <i class="bi bi-chevron-right"></i>

            </button>

            <div class="section-content"
                data-section-id="@Model.SectionId">

                <div class="section-name" data-id="@Model.SectionId">
                    @Model.SectionName
                </div>

                <div class="section-options mt-1 d-flex align-items-center gap-3">

                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input section-multiline"
                            type="checkbox"
                            id="multiline_@Model.SectionId"
                            data-section-id="@Model.SectionId"
                            @(Model.Multiline ? "checked" : "") />

                        <label class="form-check-label small"
                            for="multiline_@Model.SectionId">
                            Multiline
                        </label>
                    </div>

                    <div class="btn-group btn-group-sm section-type-group ">

                        <input type="radio"
                            id="normal_@Model.SectionId"
                            class="btn-check section-normal"
                            name="sectionType_@Model.SectionId"
                            value="Normal"
                            @( !Model.IsPharmacologyAdvice &&
                                !Model.IsVital &&
                                !Model.IsTestResult
                                ? "checked" : "") />

                        <label class="btn btn-outline-secondary"
                                for="normal_@Model.SectionId">
                            Normal
                        </label>

                        <input type="radio"
                            id="rx_@Model.SectionId"
                            class="btn-check section-rx"
                            name="sectionType_@Model.SectionId"
                            value="Rx"
                            @(Model.IsPharmacologyAdvice ? "checked" : "") />

                        <label class="btn btn-outline-primary"
                                for="rx_@Model.SectionId">
                            Rx
                        </label>

                        <input type="radio"
                            id="vital_@Model.SectionId"
                            class="btn-check section-vital"
                            name="sectionType_@Model.SectionId"
                            value="Vital"
                            @(Model.IsVital ? "checked" : "") />

                        <label class="btn btn-outline-success"
                                for="vital_@Model.SectionId">
                            Vital
                        </label>

                        <input type="radio"
                            id="testresult_@Model.SectionId"
                            class="btn-check section-testresult"
                            name="sectionType_@Model.SectionId"
                            value="TestResult"
                            @(Model.IsTestResult ? "checked" : "") />

                        <label class="btn btn-outline-info"
                                for="testresult_@Model.SectionId">
                            Test Result
                        </label>

                    </div>

                </div>

                <div class="section-preview">
                    @preview
                </div>

            </div>

            <div class="section-actions">

                <button class="insert-before btn btn-sm btn-light"
                        data-section-id="@Model.SectionId">
                    + Before
                </button>

                <button class="insert-after btn btn-sm btn-light"
                        data-section-id="@Model.SectionId">
                    + After
                </button>

                <button class="section-action-btn toggle-section"
                        data-section-id="@Model.SectionId">

                    <i class="toggle-icon @(Model.IsActive ? "bi bi-eye-slash" : "bi bi-eye")"></i>

                    <span class="toggle-text">
                        @(Model.IsActive ? "Deactivate" : "Reactivate")
                    </span>

                </button>
            </div>

        </div>

        <div id="section_@Model.SectionId"
            class="collapse section-collapse">

            <div id="fields_@Model.SectionId"
                    class="card-body fields-container"                        
                    data-section-id="@Model.SectionId">

                @foreach (var field in Model.Fields.OrderBy(f => f.DisplayOrder))
                {
                    @await Html.PartialAsync("_TemplateField", field)
                }

            </div>

        </div>
    </div>

</div>
